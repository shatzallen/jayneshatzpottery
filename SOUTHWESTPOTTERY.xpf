<Page lastSave="1115332046439" lastMod="1115332034252" lastUpdated="Thu May 05 15:27:26 PDT 2005" showingTemplate="false" dirty="" groupID="102"><Element copyrightFooterStyle="Select A Style" linkColor="#3333CC" currentWindow="1" title="SOUTHWESTPOTTERY" uidCounter="184" type="Page" pagePassword="" filename="SOUTHWESTPOTTERY" imageToolbarOff="true" onload="" passwordProtectedFile="" backgroundType="bgColor" pageURI="http://jayneshatzpottery1.homestead.com/SOUTHWESTPOTTERY.html" width="1500" keyword="" followedLinkColor="#6633CC" description="southwest pottery, native american pottery, pueblo pottery, santa clara, hopi,navajo, san ildefonso, acoma, martinez, tafoya, zuni, ancient pottery" onPublish="PageElement" onunload="" bgImage="" bgPattern="ibog:/Backgrounds#algae.gif" bgColor="#736E73" center="true" uniqueID="element1" footerTextColor="#505050" footerTextSize="12" showFooter="true" footerHasBackground="true" quicksiteDesign="true" editable="true" changed="" copyrightBy="" addCopyright="true" master="" footerTextFont="Arial" footerLinkColor="#505050" headTag=""><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-1" templateID="" height="56" editable="true" type="Text" border-width="0" padding="0" y="29" bgcolor="" x="460" sizePositionLocked="false" width="565" locked="" deletable="" uniqueID="element2"><Paragraph><Segment color="#FDEDC0" font-size="36" font-family="Times New Roman">JAYNE SHATZ POTTERY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-2" templateID="" height="66" editable="true" type="Text" border-width="0" padding="0" y="98" bgcolor="" x="611" sizePositionLocked="false" width="231" locked="" deletable="" uniqueID="element3"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Times New Roman">PhD-Prehistoric Ceramics</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Times New Roman">MA- Pottery and Sculpture</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Times New Roman">BA - Art History</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-3" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="169" bgcolor="" x="1045" sizePositionLocked="false" width="163" locked="" deletable="" uniqueID="element4"><Paragraph><Segment color="#F99976" font-size="12" font-family="Times New Roman"> </Segment><Segment color="#FDEDC0" font-size="12" font-family="Times New Roman">© 2014 Jayne E. Shatz</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-1" templateID="" alt="" height="300" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="3357" x="505" src="MOGOLLON_POTTERY.png" sizePositionLocked="false" resizeable="true" link="" width="454" locked="" deletable="" WOHratio="1.5142857142857142" fileType="IMAGEFILTER" uniqueID="element5" originalSource="" bucketRatio="1.5142857142857142" imageRatio="1.5142857142857142" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="477" origHeight="315" imageWidth="477" imageHeight="315" groupID="4"/><Element name="Image-2" templateID="" alt="" height="202" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="1576" x="169" src="basket_maker_II.png" sizePositionLocked="false" resizeable="true" link="" width="532" locked="" deletable="" WOHratio="2.63302752293578" fileType="IMAGEFILTER" uniqueID="element6" originalSource="" bucketRatio="2.63302752293578" imageRatio="2.63302752293578" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="574" origHeight="218" imageWidth="574" imageHeight="218" groupID="1"/><Element name="Image-3" templateID="" alt="" height="300" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="1525" x="883" src="pueblo_I.png" sizePositionLocked="false" resizeable="true" link="" width="258" locked="" deletable="" WOHratio="0.8605898123324397" fileType="IMAGEFILTER" uniqueID="element7" originalSource="" bucketRatio="0.8605898123324397" imageRatio="0.8605898123324397" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="321" origHeight="373" imageWidth="321" imageHeight="373" groupID="2"/><Element name="Image-4" templateID="" alt="" height="262" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="2289" x="395" src="anasazi.png" sizePositionLocked="false" resizeable="true" link="" width="286" locked="" deletable="" WOHratio="1.0918114143920596" fileType="IMAGEFILTER" uniqueID="element8" originalSource="" bucketRatio="1.0918114143920596" imageRatio="1.0918114143920596" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="440" origHeight="403" imageWidth="440" imageHeight="403" groupID="3"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-4" templateID="" height="113" editable="true" type="Text" border-width="0" padding="0" y="234" bgcolor="" x="312" sizePositionLocked="false" width="879" locked="" deletable="" uniqueID="element9"><Paragraph align="center"><Segment color="#FDEDC0" font-size="28" font-family="Times New Roman">NATIVE AMERICAN POTTERS OF THE SOUTHWEST</Segment></Paragraph><Paragraph align="center"><Segment color="#FDEDC0" font-size="24" font-family="Times New Roman">THE STORY OF OUR COUNTRY'S EARLY POTTERS</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="24" font-family="Helvetica"></Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-5" templateID="" height="786" editable="true" type="Text" border-width="0" padding="0" y="409" bgcolor="" x="84" sizePositionLocked="false" width="1317" locked="" deletable="" uniqueID="element10"><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The great Ice Age occurred between 110,000 and 12,000 years ago, and then the glaciers melted away in 11,000 BPE. A period of particular artistic fervor flourished with the Paleolithic people who roamed the Earth from 40,000 to 12,000 BPE. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">During that time, these Cro-Magnons developed the beginnings of very sophisticated art forms; </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">the first sculptures were produced around 32,000 BPE and the first kiln site was operational in 27,000 BPE. The brilliant cave paintings were executed around 15,000 BPE. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">While clay sculpture was being fired in a kiln in 27,000 BPE, until recently we had no evidence of pottery before 12,000 BPE; some of our earliest known ceramics were the magnificent vessels of the Japanese Jomon potters. However, ten years ago a fantastic discovery was made at The Xianrendong Cave in China, which dates back to 18,000 BPE. Excavations unearthed functional pottery which was created for foodstuffs, presenting us with the first cookware dating 20,000 years ago. For more detailed information on prehistoric ceramics go to my lecture at </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">http://www.jayneshatzpottery.com/ICEAGE-CERAMICS.html.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">This new discovery affords us a greater vision of pottery’s history, and so we come to ask more questions. Who laid the seedlings of America’s artistic venture, specifically my country’s ceramic heritage? We know that the earliest settlers in America’s lands originally migrated from the North, either across the Bering strait or by way of the Aleutian Islands. They come down the West coast (now California), into the Missouri and Mississippi regions. Slowly they traveled southward seeking warmth and then eastward across the central plains into the New York and Florida areas. These ancient people were descendants of the East Asian race, with warm brown skin, little body hair and broad faces outlined with straight black hair.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">We know that pottery was produced in the areas of settlement where agriculture and then masonry was practiced. The earlier hunter gatherers were people who mostly hunted or fished for their diet. They had little need for storage vessels, being nomadic; they were constantly traveling to where there was good hunting. They began producing pottery when they became more agrarian and settled down in communities. They produced coil built pottery, eventually decorating them with incised symbolic patterns. These pots were made by rotating the forms either between their legs while sitting on the ground, or resting the pot on a stable form. Later, the ware was lively painted in various colored clay slips. Some items made from clay besides heating and storage vessels were oil lamps (Eskimo), figurines, burial urns for cremations and pipes.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">There is evidence of people living in the area that we know as the American Southwest in 1500 BPE, with some evidence of pottery making. When we examine our Southwest Native Americans, we designate their prehistoric period to work produced during this time, and pottery was initially produced in Mexico and the Meso Americas. These early people formed civilizations long before the Europeans explored the New World, notably the explorations of Coronado in 1540. Around 700 PE, three large groups, the Anasazi, Hohokam, and Mogollon developed their cultures.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">There are earlier traces of pottery making in the Southeastern parts of America from the Savannah River in Georgia and South Carolina dating back to 2888 BPE, and some from northern Florida dating from 2460 BPE. However, something unique occurred in the Southwest; great pottery making centers developed in a collected group of settlements, resulting from trade and communications with neighboring tribes. These Indians developed pottery making skills to a highly sophisticated level. When we examine our Native American pottery, we refer to much of the ware produced in the Southwest Pueblos, Tribes and Reservations. Therefore, I have chosen to present this lecture on the history and development of our Native American pottery from this particular area. </Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-6" templateID="" height="279" editable="true" type="Text" border-width="0" padding="0" y="1221" bgcolor="" x="539" sizePositionLocked="false" width="402" locked="" deletable="" uniqueID="element11"><Paragraph><Segment color="#FDEDC0" font-size="18" font-family="Helvetica">DESIGNATION OF ANCIENT ERAS</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Archaic-Early Basketmaker Era&#9;7000-1500 BPE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Early Basketmaker ll Era&#9;1500 BPE-50 PE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Late Basketmaker ll Era&#9;50-500 PE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Basketmaker lll Era&#9;500-750 PE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Pueblo l Era&#9;750-900 PE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Pueblo ll Era&#9;900-1150 PE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Pueblo lll Era&#9;1150-1350 PE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Pueblo lV Era&#9;1350-1600 PE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Pueblo V Era&#9;1600-Present</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-7" templateID="" height="34" editable="true" type="Text" border-width="0" padding="0" y="1785" bgcolor="" x="287" sizePositionLocked="false" width="266" locked="" deletable="" uniqueID="element12" groupID="1"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">  LATE BASKET MAKER II PERIOD</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-8" templateID="" height="34" editable="true" type="Text" border-width="0" padding="0" y="1833" bgcolor="" x="955" sizePositionLocked="false" width="99" locked="" deletable="" uniqueID="element13" groupID="2"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">  PUEBLO 1</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-9" templateID="" height="252" editable="true" type="Text" border-width="0" padding="0" y="1955" bgcolor="" x="128" sizePositionLocked="false" width="1228" locked="" deletable="" uniqueID="element14"><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The pottery evolved during The Basket Maker II period as simple bowl forms, then expanded during Pueblo l with enclosed forms in the shape of gourds exhibiting elaborate black line figure painting. As pottery continued maturing into the Pueblo ll era, the work became more sophisticated with open bowl forms and closed containers reflecting the needs of agrarian societies which emphasized storage needs.  </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Pottery grew in complexity as the cultures progressed into the Pueblo lll era, using black sip as the background with white areas for design, as well as the traditional white background with black design. Color emerged in the pottery with the addition of bright orange red earthen slips and clay bodies and a more bold abstract style. Of the earliest developing Basket Maker cultures, the Anasazi were the most prolific potters, leaving behind a great legacy of work. However, they disappeared, and no one really knows what happened to the them. Toward the end of their cultural reign, the Anasazi moved into cliff houses with no apparent violent end to their story. What we do know is that after the 1300's they experienced severe draughts and poor soil management, and they began abandoning their homes. They had a large population that slowly dispersed into the Rio Grande and Hopi mesas. Many believe the Hopi are the true descendants of the Anasazi.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-10" templateID="" height="52" editable="true" type="Text" border-width="0" padding="0" y="2564" bgcolor="" x="545" sizePositionLocked="false" width="400" locked="" deletable="" uniqueID="element15" groupID="3"><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica">   </Segment><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">COLORED ANASAZI BOWL AND JUG 900-1000 PE </Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-5" templateID="" alt="" height="248" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="2297" x="780" src="colored_anasazi_bowl.png" sizePositionLocked="false" resizeable="true" link="" width="264" locked="" deletable="" WOHratio="1.0625" fileType="IMAGEFILTER" uniqueID="element16" originalSource="" bucketRatio="1.064516129032258" imageRatio="1.0625" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="-16" contrast="0.6059999999999999" colorEffect="tint" tintRed="-0.05" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="340" origHeight="320" imageWidth="340" imageHeight="320" groupID="3"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-11" templateID="" height="681" editable="true" type="Text" border-width="0" padding="0" y="2668" bgcolor="" x="133" sizePositionLocked="false" width="1259" locked="" deletable="" uniqueID="element17"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">PRIMITIVE FIRING TECHNIQUES</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">There are two basic pit firing techniques developed by prehistoric potters which are still employed today by contemporary traditional potters of the Southwest. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">They are shallow pits with the floor covered in a layer of fuel; this fuel could be wood, branches, bones, corncobs, etc.- any carbon, organic material. Today, traditional potters use mostly wood and sheep dung. When the fuel is smoldering, vessels are set down on shards, and surrounded by more shards for protection against falling debris. Pots must be made with well tempered, or grogged material for strength and to help prevent cracking during firing. Grog is made from previously fired shards that are ground up and added to the clay body. On top of the protective shards, more fuel is added to the pit, and then fired to desired temperatures. Present day potters use metal racks to set their pots on and protective sheet metal to cover them during the firing. Upon cool down, dirt and dung are added to the smoldering fire, developing the rich black colors in this reduction atmosphere. For those potters who worked in bright red and orange slip painted clay bodies, they fired their ware in open pits, with no covering. This provides the firing an oxidized atmosphere, developing the bright red coloring. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Ancient/Prehistoric pueblos (communities of the Southwest Native Americans) with overlapping cultures:</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">&#9;Mogollon (Hohokam)</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">&#9;Hohokam (Salado and Sinagua)</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">&#9;Mimbres</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">&#9;Salado</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">&#9;Anasazi</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">&#9;Hopi (Sinagua)  </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">MOGOLLON, 1-1450 PE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Mogollon, (mug-ee-on), were the first documented potters in the Southwest regions. They were the first to grow corn and squash, and the first to irrigate, which led to a very successful agrarian society. These agrarian people needed storage vessels for their food items. They initially had mud lined baskets in the Early Basket Maker ll era; later on they developed a more permanent pottery with fired ware. They fired their coil built pottery upside down to create a blurred black smokey inner surface to the ware. They employed carved textural designs as well as simple painted geometric lines. They buried their dead, which enabled archaeologists to discover shards and pottery. Like many ancient civilizations, they slowly merged with other clans, increasing their lands and strengthening the variety in their culture. The Mogollon became related to the Hohokam, Saledo, Sinagua and eventually the Mimbres societies. </Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-12" templateID="" height="34" editable="true" type="Text" border-width="0" padding="0" y="3666" bgcolor="" x="579" sizePositionLocked="false" width="316" locked="" deletable="" uniqueID="element18" groupID="4"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">EARLY MOGOLLON POTTERY ca. 1000 </Segment><Segment color="#000000" font-size="10" font-family="Helvetica">PE</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-13" templateID="" height="254" editable="true" type="Text" border-width="0" padding="0" y="3734" bgcolor="" x="149" sizePositionLocked="false" width="1292" locked="" deletable="" uniqueID="element19"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">MIMBRES, 800-1200 PE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Mimbres group is associated with the Mogollon clan, and branched off from them in the Mimbres Valley in southwestern New Mexico. The earliest Mimbres ware was grouped with the Mogollon, reaching a high point in pottery making in two different periods, the Three Circles Mimbres, (825-1000) and the Classic Mimbres (1000-1200). Mimbres pottery is best known for their black on white and black on cream clay bodies. Their extremely large vessels showed bold designs, displaying animal and human figures, geometric lines and iconographic drawings representing the land around them. Mimbres pottery is also uniquely identified with "killer holes" in the bottom of large bowls. They practiced burying their dead, which included placing a bowl that had a hole in its bottom over the face of the dead. In true Mimbres killer hole pots, the hole was punched from the INSIDE out, which allowed the departed spirit to escape to the next world. Pottery was sacred to the Mimbres, therefore they never traded their ware. While black on white pottery was also produced by the Anasazi, they usually did not paint human figures. If you see figures painted on a black on white pot, it is most likely Mimbres, not Anasazi. The Mimbres died out and their survivors painted their pottery much the same as their neighboring tribes, becoming indistinguishable.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-6" templateID="" alt="" height="254" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="4061" x="279" src="killer_hole_mimbres.png" sizePositionLocked="false" resizeable="true" link="" width="434" locked="" deletable="" WOHratio="1.706896551724138" fileType="IMAGEFILTER" uniqueID="element20" originalSource="" bucketRatio="1.706896551724138" imageRatio="1.706896551724138" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="495" origHeight="290" imageWidth="495" imageHeight="290" groupID="6"/><Element name="Image-7" templateID="" alt="" height="248" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="4053" x="891" src="mimbres_geometric.png" sizePositionLocked="false" resizeable="true" link="" width="280" locked="" deletable="" WOHratio="1.1295180722891567" fileType="IMAGEFILTER" uniqueID="element21" originalSource="" bucketRatio="1.1295180722891567" imageRatio="1.1295180722891567" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="375" origHeight="332" imageWidth="375" imageHeight="332" groupID="5"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-14" templateID="" height="34" editable="true" type="Text" border-width="0" padding="0" y="4322" bgcolor="" x="337" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element22" groupID="6"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"> KILLER HOLE MIMBRES POTTERY</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-15" templateID="" height="52" editable="true" type="Text" border-width="0" padding="0" y="4310" bgcolor="" x="828" sizePositionLocked="false" width="424" locked="" deletable="" uniqueID="element23" groupID="5"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">MIMBRES POTTERY WITH GEOMETRIC LINES 1200 PE</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-16" templateID="" height="473" editable="true" type="Text" border-width="0" padding="0" y="5016" bgcolor="" x="104" sizePositionLocked="false" width="1279" locked="" deletable="" uniqueID="element24"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">SALADO, 100-1450 PE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Salado people produced red pottery in the Arizona area, their culture being a blending of the Mogollon, Hohokam, Sinagua and Anasizi groups. Their work was identified by black and white decorations painted on a red clay body. These people were market driven, producing whatever was "trendy" in the traveling markets. This fundamental philosophy made them tradesmen, and because of this, they borrowed </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">stylistically in place of necessity. They developed their pottery with polychrome decoration, utilizing the minerals in their area to paint their designs. The height of their pottery making occurred between 1300-1400 PE.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">ANASAZI, 1-1350 PE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Anasazi were the most notable of all the ancient potters of the American Southwest. They initially lived in caves, and by 800 PE, they developed the hi-rise architectural structures we see dotting the Southwest. When people discuss the ancient pottery of our country, they usually associate it with the Anasizi's. The Anasazi were agrarian, built sophisticated canals, and were highly trade oriented. They inhabited a vast territory of 20,000 square miles from Tusayan, Arizona to Mesa Verde, Colorado and to Chaco Canyon, New Mexico. Their canals were fed by reservoirs such as the remarkable half million gallon reservoir in Mesa Verde. But, like the other ancient cultures, they did not last long beyond the mid 1300's, probably due to running out of firewood, depleting soil quality and a general loss of resources. They developed a bright white slip that covered their plain grey clay body, and used vegetable and mineral resources to make a dark black slip. Anasazi pottery was decorated in bold geometric patterns on thin walled vessels; their work was sophisticated and complex, demonstrating a bold painterly flair. They traded extensively in Chaco Canyon, developing their functional craft ware into a highly decorated art form. Anasazi potters are famous for their black on white ware, but by the 1200s, they began producing the highly demanded red ware. By the 1300s, they were gone, as were so many other pueblo tribes, but they were always in the lore of the Native Americans. The people of San Ildefonso, Santa Clara and Zuni pueblos lay claim to Anasazi heritage; the Hopi believe they are direct descendants. By the mere fact that so many contemporary Southwest Native cultures claim to be of Anasazi heritage, only suggests the uniqueness of the Anasazi people  </Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-8" templateID="" alt="" height="195" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="5559" x="234" src="PUEBLO_II.png" sizePositionLocked="false" resizeable="true" link="" width="460" locked="" deletable="" WOHratio="2.3595041322314048" fileType="IMAGEFILTER" uniqueID="element25" originalSource="" bucketRatio="2.3580786026200875" imageRatio="2.3595041322314048" offsetX="0.004570383912248629" offsetY="-0.00646551724137931" zoom="1.012962962962963" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="571" origHeight="242" imageWidth="571" imageHeight="242" groupID="9"/><Element name="Image-9" templateID="" alt="" height="253" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="5526" x="829" src="PUEBLO_III.png" sizePositionLocked="false" resizeable="true" link="" width="396" locked="" deletable="" WOHratio="1.5632183908045978" fileType="IMAGEFILTER" uniqueID="element26" originalSource="" bucketRatio="1.5632183908045978" imageRatio="1.5632183908045978" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="544" origHeight="348" imageWidth="544" imageHeight="348" groupID="8"/><Element name="Image-10" templateID="" alt="" height="237" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="5848" x="484" src="PUEBLO_III_FIRST_MUGS.png" sizePositionLocked="false" resizeable="true" link="" width="558" locked="" deletable="" WOHratio="2.354330708661417" fileType="IMAGEFILTER" uniqueID="element27" originalSource="" bucketRatio="2.354330708661417" imageRatio="2.354330708661417" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="598" origHeight="254" imageWidth="598" imageHeight="254" groupID="7"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-17" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="5764" bgcolor="" x="399" sizePositionLocked="false" width="99" locked="" deletable="" uniqueID="element28" groupID="9"><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica">   </Segment><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">PUEBLO II</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-18" templateID="" height="34" editable="true" type="Text" border-width="0" padding="0" y="5787" bgcolor="" x="977" sizePositionLocked="false" width="86" locked="" deletable="" uniqueID="element29" groupID="8"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">PUEBLO III</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-19" templateID="" height="34" editable="true" type="Text" border-width="0" padding="0" y="6090" bgcolor="" x="666" sizePositionLocked="false" width="201" locked="" deletable="" uniqueID="element30" groupID="7"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"> PUEBLO III FIRST MUGS </Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-20" templateID="" height="227" editable="true" type="Text" border-width="0" padding="0" y="6191" bgcolor="" x="106" sizePositionLocked="false" width="1276" locked="" deletable="" uniqueID="element31"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">HOPI and SINAGUA </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Anasazi also produced a yellow to orange ware that signified the development of Hopi pottery. The Hopi believe to be direct descendants of the Anasazi, and believe they developed their yellow ware from their ancestral Anasazi roots. The Sinagua also developed this yellow pottery from Hopi influence. Sinagua, which means, "without water" developed a broad irrigation system, enabling their culture to survive in cliff dwellings in the Flagstaff Arizona area, until they were gone in 1425. In the 1200's, the Anasazi built pueblos on the Hopi mesas, exactly where the Hopi live today, and eventually the Anasazi melded into the Hopi. The Hopi developed their pottery tradition from the Anasazi and Sinagua, displaying the original black on white pottery to the orange red and then yellow polychrome, now identified as Hopi ware. Their work is derived from a heritage that crossed over centuries, rather than a separate unique style. This demonstration of ancestral links to the Anasazi is what makes Hopi pottery so marvelous. The Hopi exist today, breaking the century's sad story of disappearance.  </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-11" templateID="" alt="" height="258" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="6450" x="507" src="SINAGUA_AND_HOPI.png" sizePositionLocked="false" resizeable="true" link="" width="521" locked="" deletable="" WOHratio="2.0193798449612403" fileType="IMAGEFILTER" uniqueID="element32" originalSource="" bucketRatio="2.0193798449612403" imageRatio="2.0193798449612403" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0.264" colorEffect="tint" tintRed="-0.13" tintGreen="0" tintBlue="0.05" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="521" origHeight="258" imageWidth="521" imageHeight="258" groupID="10"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-21" templateID="" height="34" editable="true" type="Text" border-width="0" padding="0" y="6718" bgcolor="" x="637" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element33" groupID="10"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">SINAGUA AND EARLY HOPI WARE</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-22" templateID="" height="489" editable="true" type="Text" border-width="0" padding="0" y="6812" bgcolor="" x="111" sizePositionLocked="false" width="1288" locked="" deletable="" uniqueID="element34"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">THE MODERN ERA </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">HISTORY OF THE SOUTHWEST NATIVE AMERICAN INDIANS, </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">14th -19th Century</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Spain came to the New World in 1519 with the arrival of Hernon Cortez, who with only 500 men armed with guns, in a few short years conquered Mexico City and the Aztecs. Once this event was made known, thousands of Europeans came to the area looking for the much proclaimed illusive gold. With his great success, he then sent for a larger army, which brought Vasquez Coronado in 1540. This marked the first year the Europeans governed the Southwest. Coronado moved through the territories, beginning at Zuni, then Hopi but found no gold. However, he found the Grand Canyon and modern day Albuquerque, burning villages, raping and pillaging along the way. He then returned to New Spain, (Mexico City) in 1542, never finding any gold, and never to return. But many continued to follow his tracks, converting the natives to Catholicism and outlawing their traditional ways. A great building boom occurred with missions dotting the landscape. Taxes were enforced, starving the Indians until the Indians banned together with armed warriors from neighboring pueblos, and led the Great Revolt of 1680. These fierce Indians attacked the Spanish, killing over 400 men, women, children and priests. They burned missions, marched into Santa Fe and fought off over 1500 Spaniards, who fled to El Paso, New Mexico. But with all this force, the weary Indians finally surrendered after being out maneuvered by Don Diego de Vargas by only 200 soldiers. Now, once again they accepted Catholicism and the Spanish.  </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">By the 18th century, hunger, hardships, smallpox and Navajo and Apache raids broke the spirits of the pueblo people. In 1821, Spain ceded the Southwest to Mexico, but in 1846, the American government entered and took over. They imposed new regulations; the Indians were free of Catholicism, were forced to live in missions that were run by Methodists and Mormons and were forced to join their churches. By the second half of the 19th century, more Americans came into the areas, providing trade with the Indians, which helped the pueblos to survive on some level. However, for the next hundred years, the Indians, once again, were forced to accept new regulations, pay heavy taxes, speak English and become Christians. Yet with all these enforcements, American traders learned about the Indian artists and crafters in order to trade with them; they learned Indian culture, language and customs. Commercialism helped keep a part of the Indian heritage alive. </Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-23" templateID="" height="653" editable="true" type="Text" border-width="0" padding="0" y="7365" bgcolor="" x="110" sizePositionLocked="false" width="1275" locked="" deletable="" uniqueID="element35"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">SOUTHWEST POTTERY OF THE 20th CENTURY</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">There are nineteen pueblos in New Mexico, one pueblo and one tribe in Arizona, one pueblo in Texas and three reservations that span the Southwest which are recognized by the U.S. Federal government. They are listed as follows:</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">ACOMA     &#9;&#9;New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">COCHITI      New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">HOPI TRIBE    &#9;Arizona</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">ISLETA    New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">JEMEZ     &#9;&#9;&#9;New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">LAGUNA&#9;    New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">MARICOPA&amp;PIMA    Arizona</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">NAMBE&#9;    &#9;&#9;New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">OHKAY OWINGEH  New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">PICURIS      New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">POJOAQUE   &#9;&#9;New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">SAN FELIPE&#9;    New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">SAN ILDEFONSO  New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">SANDIA     New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">SANTA ANA&#9;   New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">SANTA CLARA  New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">SANTO DOMINGO  &#9;New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">TAOS     &#9;&#9;&#9;New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">TESUQUE   &#9;&#9;New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">YSLETA DEL SUR    Texas</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">ZIA             &#9;&#9;&#9;&#9;New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">ZUNI           New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">MESCALERO&#9;&#9;Apache Reservation, New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">JICARILLA &#9;&#9;Apache, Reservation, New Mexico</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">NAVAJO&#9;&#9;&#9;Reservation, 4 Corners-NM, AZ, UT</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-24" templateID="" height="703" editable="true" type="Text" border-width="0" padding="0" y="8051" bgcolor="" x="109" sizePositionLocked="false" width="1271" locked="" deletable="" uniqueID="element36"><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The difference between a pueblo and a reservation originates from the fact that the Pueblo Indians had their land granted to them (as did the Mexican residents of New Mexico) in 1848 in the Treaty of Guadalupe-Hildago between the U.S. and Mexico. Most Indian reservations were established in treaties between the U.S. and the Indian tribes themselves. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">For this presentation of Native American Pottery, I will focus on the most influential potters of the pueblos, tribes and reservations of the Southwest. These particular communities have brought forth some of the most famous American potters of the 20th century. Therefore, instead of a brief overview of all twenty five groups, I will present a more in depth discussion of the work produced by these potters, reflecting a comprehensive survey of pottery produced by our Native Americans in the Southwest. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">THE SEVEN FAMILIES</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">In 1974, the Maxwell Museum of Anthropology at the University of New Mexico, had an exhibit of seven family members of pueblo potters, each descended from a celebrated matriarch. This singular exhibit that showcased these potters had a profound effect on the lives of Native American potters. The exhibit propelled these seven families into fame and fortune as leaders in their people's pottery movement. I will be discussing these seven families as well as other renown potters of the Southwest. Many deserving potters from other pueblos did not share in this experience directly, but the impact of this show was a dramatic rise in our country's awareness and appreciation of all Native American pottery. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">With each pueblo, I will present the historical information of the community, then introduce the potters who transformed our American Pottery tradition. As attention increased on our Native Americans, people in our own country as well as the world over finally began to comprehend the greatness of the art of our native peoples, a tradition in art that began before any Europeans ever came to our shores.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Seven Families:</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica" underline="true">Acoma</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">&#9;Lucy Lewis and Marie Chino</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica" underline="true">San Ildefonso</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">&#9;Maria Martinez and Rose Gonzales</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica" underline="true">Santa Clara</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">&#9;Sara Fina Tafoya and Lela Gutierrez</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica" underline="true">Hopi</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">&#9;Nampeyo family</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-25" templateID="" height="338" editable="true" type="Text" border-width="0" padding="0" y="8797" bgcolor="" x="106" sizePositionLocked="false" width="1252" locked="" deletable="" uniqueID="element37"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">ACOMA</Segment><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">   </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Acoma people are called the "People of the White Rock", or people of Sky City. This pueblo has the distinction of being the oldest continuously occupied settlement in the U.S. Sky City exists today, still with no electricity or running water. The people who live there go down the mountain with buckets for water as they did for hundreds of years. There is a road now that goes up to the top, and while some continue to walk down the mountain for their water and supplies, many of the people drive up and down with buckets for water and supplies. However, all still live with no electricity. This is a choice, as below the mountain is a settlement of Acoma people who live much the same way as other modern pueblos. Then why do people go up the mountain to live this kind of life? I was very fortunate to visit Acoma and go up the mountain to Sky City. The buildings are beautiful adobe structures with white ladders on the outside, enabling them to climb up the levels or stories of the buildings. This type of architecture is typical of the ancient pueblo structures; access to their multi storied edifices were made via these outdoor ladders, so that during the numerous invasions, the ladders were brought in, keeping the invaders out. People choose to live in Sky City almost as a retreat or spiritual connection to their ancestors. There is a large church with painted walls that is still in use today for weddings and other ceremonies. What was so outstanding about my visit, was that there were potters selling their wares on tables outside their homes. As we know, the ancients had no running water or electricity in their homes, so obviously, these modern day potters are able to produce and fire pottery in much the same way their ancestors did. However, Acoma as well as Zuni potters have moved into electric kiln firings and commercial clay and glazes for some of their non traditional ware. A discussion of this phenomena is at the end of my presentation in the Zuni section.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-12" templateID="" alt="" height="253" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="9584" x="274" src="ACOMA_HOUSE-2.JPG" sizePositionLocked="false" resizeable="true" link="" width="380" locked="" deletable="" WOHratio="1.5037593984962405" fileType="IMAGEFILTER" uniqueID="element38" originalSource="" bucketRatio="1.5038461538461538" imageRatio="1.5037593984962405" offsetX="0.00628140703517588" offsetY="0.005660377358490566" zoom="1.0179028132992327" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="532" imageWidth="800" imageHeight="532" groupID="11"/><Element name="Image-13" templateID="" alt="" height="266" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="10008" x="718" src="ACOMA_BREAD_OVEN.JPG" sizePositionLocked="false" resizeable="true" link="" width="400" locked="" deletable="" WOHratio="1.5037593984962405" fileType="IMAGEFILTER" uniqueID="element39" originalSource="" bucketRatio="1.5037593984962405" imageRatio="1.5037593984962405" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="532" imageWidth="800" imageHeight="532" groupID="13"/><Element name="Image-14" templateID="" alt="" height="253" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="9587" x="730" src="ACOMA_HOUSE.JPG" sizePositionLocked="false" resizeable="true" link="" width="380" locked="" deletable="" WOHratio="1.5037593984962405" fileType="IMAGEFILTER" uniqueID="element40" originalSource="" bucketRatio="1.5037593984962405" imageRatio="1.5037593984962405" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="532" imageWidth="800" imageHeight="532" groupID="11"/><Element name="Image-15" templateID="" alt="" height="383" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="9969" x="363" src="ACOMA_LADDER.jpg" sizePositionLocked="false" resizeable="true" link="" width="255" locked="" deletable="" WOHratio="0.665" fileType="IMAGEFILTER" uniqueID="element41" originalSource="" bucketRatio="0.665" imageRatio="0.665" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="532" origHeight="800" imageWidth="532" imageHeight="800" groupID="12"/><Element name="Image-16" templateID="" alt="" height="390" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="10429" x="395" src="ACOMA_POTTER_-2.jpg" sizePositionLocked="false" resizeable="true" link="" width="259" locked="" deletable="" WOHratio="0.665" fileType="IMAGEFILTER" uniqueID="element42" originalSource="" bucketRatio="0.665" imageRatio="0.665" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="532" origHeight="800" imageWidth="532" imageHeight="800" groupID="14"/><Element name="Image-17" templateID="" alt="" height="286" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="10451" x="727" src="ACOMA_POTTER.JPG" sizePositionLocked="false" resizeable="true" link="" width="430" locked="" deletable="" WOHratio="1.5037593984962405" fileType="IMAGEFILTER" uniqueID="element43" originalSource="" bucketRatio="1.5037593984962405" imageRatio="1.5037593984962405" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="532" imageWidth="800" imageHeight="532" groupID="14"/><Element name="Image-18" templateID="" alt="" height="295" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="10903" x="742" src="ACOMA_SLIPS.JPG" sizePositionLocked="false" resizeable="true" link="" width="444" locked="" deletable="" WOHratio="1.5037593984962405" fileType="IMAGEFILTER" uniqueID="element44" originalSource="" bucketRatio="1.5037593984962405" imageRatio="1.5037593984962405" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="532" imageWidth="800" imageHeight="532" groupID="15"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-26" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="9852" bgcolor="" x="562" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element45" groupID="11"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">ACOMA HOUSES IN SKY CITY TODAY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-27" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="10338" bgcolor="" x="337" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element46" groupID="12"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">OUTSIDE LADDER ON ACOMA HOME</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-28" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="10281" bgcolor="" x="766" sizePositionLocked="false" width="313" locked="" deletable="" uniqueID="element47" groupID="13"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">OUTDOOR BREAD OVEN ACOMA HOME</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-29" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="10788" bgcolor="" x="691" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element48" groupID="14"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">PRESENT DAY SKY CITY POTTERS</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-30" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="11204" bgcolor="" x="767" sizePositionLocked="false" width="400" locked="" deletable="" uniqueID="element49" groupID="15"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">SLIPS USED BY PRESENT DAY ACOMA POTTERS</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-31" templateID="" height="105" editable="true" type="Text" border-width="0" padding="0" y="11297" bgcolor="" x="80" sizePositionLocked="false" width="1116" locked="" deletable="" uniqueID="element50"><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Typical Acoma ware is a white clay body, decorated in red and black slips, with a soft matte texture. In 1880, the railroad brought many tourists to the area, who purchased these vessels, and the Acoma people made work to satisfy this trade. They excelled in "ollas", large jars with dramatic graphic designs. While they no longer use their clay vessels for storage, using more contemporary pots and pans, they continue to make these gorgeous pots for the tourist trade. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-19" templateID="" alt="" height="301" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="9171" x="516" src="TRADITIONAL_ACOMA_POTTERY.png" sizePositionLocked="false" resizeable="true" link="" width="445" locked="" deletable="" WOHratio="1.478405315614618" fileType="IMAGEFILTER" uniqueID="element51" originalSource="" bucketRatio="1.478405315614618" imageRatio="1.478405315614618" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="445" origHeight="301" imageWidth="445" imageHeight="301" groupID="32"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-32" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="9478" bgcolor="" x="584" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element52" groupID="32"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">TRADITIONAL ACOMA POTTERY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-33" templateID="" height="170" editable="true" type="Text" border-width="0" padding="0" y="11454" bgcolor="" x="76" sizePositionLocked="false" width="1125" locked="" deletable="" uniqueID="element53"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">LUCY LEWIS, 1900?-1992</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Lucy Lewis is one of the most famous potters of the 20th century. She began making pottery at age seven and by the 1940's she had significant attention from collectors for her prehistoric designs on modern pottery. In 1958, Lucy met with Kennith Chapmen from the Museum of New Mexico who suggested to Lucy to employ the ancient Mimbres black on white design onto her pottery. Lucy already had been exposed to ancient Mimbres shards all her life, and this type of decoration was natural to her. Lucy's daughters followed in her steps in pottery making, but the tradition has died out with the grandchildren. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-20" templateID="" alt="" height="276" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="10910" x="250" src="JAYNE_AND_ACOMA_POTTER.JPG" sizePositionLocked="false" resizeable="true" link="" width="415" locked="" deletable="" WOHratio="1.5037593984962405" fileType="IMAGEFILTER" uniqueID="element54" originalSource="" bucketRatio="1.5037593984962405" imageRatio="1.5037593984962405" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="532" imageWidth="800" imageHeight="532" groupID="16"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-34" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="11196" bgcolor="" x="244" sizePositionLocked="false" width="421" locked="" deletable="" uniqueID="element55" groupID="16"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">JAYNE SHATZ AND PRESENT DAY SKY CITY  POTTER</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-21" templateID="" alt="" height="336" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="11665" x="355" src="LUCY_LEWIS.png" sizePositionLocked="false" resizeable="true" link="" width="229" locked="" deletable="" WOHratio="0.682741116751269" fileType="IMAGEFILTER" uniqueID="element57" originalSource="" bucketRatio="0.682741116751269" imageRatio="0.682741116751269" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="269" origHeight="394" imageWidth="269" imageHeight="394" groupID="33"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-35" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="12008" bgcolor="" x="409" sizePositionLocked="false" width="104" locked="" deletable="" uniqueID="element58" groupID="33"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">LUCY LEWIS</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-22" templateID="" alt="" height="286" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="12110" x="276" src="Lucy_Lewis_red_and_black_on_white.png" sizePositionLocked="false" resizeable="true" link="" width="340" locked="" deletable="" WOHratio="1.1900826446280992" fileType="IMAGEFILTER" uniqueID="element59" originalSource="" bucketRatio="1.1900826446280992" imageRatio="1.1900826446280992" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="432" origHeight="363" imageWidth="432" imageHeight="363" groupID="37"/><Element name="Image-23" templateID="" alt="" height="295" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="12115" x="810" src="L__Lewis_black_on_white.png" sizePositionLocked="false" resizeable="true" link="" width="309" locked="" deletable="" WOHratio="1.0465686274509804" fileType="IMAGEFILTER" uniqueID="element61" originalSource="" bucketRatio="1.0465686274509804" imageRatio="1.0465686274509804" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="427" origHeight="408" imageWidth="427" imageHeight="408" groupID="36"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-36" templateID="" height="54" editable="true" type="Text" border-width="0" padding="0" y="12401" bgcolor="" x="283" sizePositionLocked="false" width="330" locked="" deletable="" uniqueID="element62" groupID="37"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">LUCY LEWIS, RED AND BLACK ON WHITE, DEAR WITH HEART DESIGN, 1968</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-37" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="12415" bgcolor="" x="839" sizePositionLocked="false" width="250" locked="" deletable="" uniqueID="element63" groupID="36"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">LUCY LEWIS BLACK ON WHITE PREHISTORIC EFFECT</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-38" templateID="" height="191" editable="true" type="Text" border-width="0" padding="0" y="12520" bgcolor="" x="76" sizePositionLocked="false" width="1224" locked="" deletable="" uniqueID="element64"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">MARIE CHINO, 1907-1982</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Marie Chino was as talented as Lucy Lewis, but for some reason did not gain the notoriety that Lucy had. They were friends as well as competitors, oftentimes painting each other's pots with their own designs, creating a famous collaboration. Marie was a prize winner at the first Southwest Indian Fair in 1922, a very prestigious event. Like Lucy, Marie's inspiration germinated from ancient shards around the Acoma pueblo. There is an ancient cave near the pueblo that contained prehistoric shards that Marie and other potters visited for learning ancient designs. Marie had five daughters who pursued pottery making, three of whom gained much recognition, but unfortunately, similarly to Lucy's family, the grandchildren have not continued the pottery making tradition. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-24" templateID="" alt="" height="335" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="12746" x="329" src="MARIE_CHINO.png" sizePositionLocked="false" resizeable="true" link="" width="242" locked="" deletable="" WOHratio="0.7223880597014926" fileType="IMAGEFILTER" uniqueID="element65" originalSource="" bucketRatio="0.7223880597014926" imageRatio="0.7223880597014926" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="242" origHeight="335" imageWidth="242" imageHeight="335" groupID="20"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-39" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="13087" bgcolor="" x="375" sizePositionLocked="false" width="121" locked="" deletable="" uniqueID="element66" groupID="20"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">MARIE CHINO</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-26" templateID="" alt="" height="309" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="12750" x="774" src="MARIE_CHINO-1.png" sizePositionLocked="false" resizeable="true" link="" width="367" locked="" deletable="" WOHratio="1.1877022653721683" fileType="IMAGEFILTER" uniqueID="element68" originalSource="" bucketRatio="1.1877022653721683" imageRatio="1.1877022653721683" offsetX="0.004032258064516129" offsetY="-0.006389776357827476" zoom="1.0129449838187703" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="367" origHeight="309" imageWidth="367" imageHeight="309" groupID="21"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-40" templateID="" height="48" editable="true" type="Text" border-width="0" padding="0" y="13064" bgcolor="" x="805" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element69" groupID="21"><Paragraph align="center"><Segment color="#FDEDC0" font-size="10" font-family="Helvetica">MARIE CHINO BLACK ON WHITE. 1972</Segment></Paragraph><Paragraph align="center"><Segment color="#FDEDC0" font-size="10" font-family="Helvetica">6 3/4 X 9 3/4 IN.</Segment></Paragraph><Paragraph align="center"><Segment color="#FDEDC0" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-41" templateID="" height="401" editable="true" type="Text" border-width="0" padding="0" y="13178" bgcolor="" x="92" sizePositionLocked="false" width="1250" locked="" deletable="" uniqueID="element70"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">HOPI</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Three Hopi mesas, which are flat toped hills, have nine villages, with the First Mesa and the village of Hano being the most well known in pottery making; this is largely due to the unique clay found in the their mountains. Hopi pottery goes back thousands of years, like the Anasazi, they too claim to be the oldest continuous living settlement at their Third Mesa village of Old Oraibi, which goes back to the twelfth century. Actually, the Hopi Reservation lives on a three thousand square mile island within the great Navajo Reservation, northeast of Flagstaff.  </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Hopi's Anasazi and Sinagua ancestors spoke different languages; the Hopi today speak a Uto-Aztecan tongue, as do many of the Southwest tribes. Hopi history and religion is intertwined with the Zuni people, with the Zuni's speaking their own language. Therefore, most of the Native Americans in the Southwest speak a common English. Hopi pottery was traded widely from the 700's on, but diminished greatly by the 1800's. However, in the early 19th century, draught and epidemic caused many Hopis to take temporary refuge in Zuni, where they relearned their pottery making traditions from the Zunis. The railroad's presence brought many traders, increasing the need for Indian wares. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Hopi ware was characterized by a white or yellow slip with crazed lines over the ware. Then a local trader asked the Hopis to reproduce their archaic forms of the abandoned first Mesa, Sikyatki, which enabled Hopi potters to gain influence and prestige in their work. By the 1900's the Nampeyo family had achieved great notoriety, defining 20th century Hopi pottery. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-27" templateID="" alt="" height="302" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="13585" x="488" src="HOPI_POTTERY.png" sizePositionLocked="false" resizeable="true" link="" width="493" locked="" deletable="" WOHratio="1.6324503311258278" fileType="IMAGEFILTER" uniqueID="element71" originalSource="" bucketRatio="1.6324503311258278" imageRatio="1.6324503311258278" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="493" origHeight="302" imageWidth="493" imageHeight="302" groupID="22"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-42" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="13889" bgcolor="" x="609" sizePositionLocked="false" width="242" locked="" deletable="" uniqueID="element72" groupID="22"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">TRADITIONAL HOPI POTTERY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-43" templateID="" height="233" editable="true" type="Text" border-width="0" padding="0" y="13992" bgcolor="" x="80" sizePositionLocked="false" width="1218" locked="" deletable="" uniqueID="element73"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">NAMPEYO, 1860-1942</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The potter Nampeyo, was born at the first Mesa at Hano. She was producing pottery at a very young age, but the Smithsonian expedition of J. Walter Fewkes in 1896 had unearthed some ancient pottery which he showed to Nampeyo, the wife of one of his workman. She enthusiastically created a Hopi Sikyatki revival of pottery, which inspired other Hopi potters. These ancient Hopi designs and low shouldered forms became the landmark of Nampeyo's pottery and future Hopi potters. In the 1990's Fred Harvey, the entrepreneur of much of the Grand Canyon’s hotels and outer buildings, brought her to the Canyon to demonstrate Hopi pottery making for hotel guests. He then brought her to Chicago at a US exposition where she introduced Southwestern pottery to the world. Nampeyo's three daughters became potters, Fannie becoming famous in her own right. The six generations of Nampeyo descendants are vast, and Hopi pottery is still made today in the traditional way, employing both traditional and contemporary styles. At the Grand Canyon, there is a replica of a traditional Hopi house, which stands as a museum, exhibiting and selling Hopi art and pottery.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-28" templateID="" alt="" height="217" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="14292" x="109" src="NAMPEYO_POTTERY.png" sizePositionLocked="false" resizeable="true" link="" width="327" locked="" deletable="" WOHratio="1.5075757575757576" fileType="IMAGEFILTER" uniqueID="element74" originalSource="" bucketRatio="1.5075757575757576" imageRatio="1.5075757575757576" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="398" origHeight="264" imageWidth="398" imageHeight="264" groupID="41"/><Element name="Image-29" templateID="" alt="" height="220" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="14291" x="501" src="NAMPEYO_POLYCHROME.png" sizePositionLocked="false" resizeable="true" link="" width="440" locked="" deletable="" WOHratio="2" fileType="IMAGEFILTER" uniqueID="element75" originalSource="" bucketRatio="2" imageRatio="2" offsetX="0.007326007326007326" offsetY="-0.009157509157509158" zoom="1.0186567164179106" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="536" origHeight="268" imageWidth="536" imageHeight="268" groupID="42"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-44" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="14515" bgcolor="" x="190" sizePositionLocked="false" width="141" locked="" deletable="" uniqueID="element76" groupID="41"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">NAMPEYO STYLE</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-45" templateID="" height="54" editable="true" type="Text" border-width="0" padding="0" y="14515" bgcolor="" x="587" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element77" groupID="42"><Paragraph align="center"><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">NAMPEYO POLYCHROME, 1930</Segment></Paragraph><Paragraph align="center"><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">12 1/2 X 8 1/2 IN</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-46" templateID="" height="211" editable="true" type="Text" border-width="0" padding="0" y="14651" bgcolor="" x="111" sizePositionLocked="false" width="1213" locked="" deletable="" uniqueID="element78"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">FANNIE NAMPEYO, 1900-1987</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Nampeyo's three daughters, Annie, Nellie and Fannie, all became accomplished potters, but Fannie Polacca Nampeyo is perhaps the most famous. She produced her work during a period when collectors were seriously collecting signed Southwest pottery. She remained true to traditional vessel construction and design throughout her career. She made coil built pieces and then laboriously burnished the slip painted surfaces; the result was a beautiful patina. In the early 1920's she married Vinton Polacca and then pursued her pottery making as an important part of her life. She had worked with her mother, learning the techniques and styles of traditional ware. Fannie was extremely prolific and earned her reputation as an outstanding potter. Her work included black and red slip designs on yellow pottery. Her works have been included in many collections, museums and universities.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-30" templateID="" alt="" height="317" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="14928" x="204" src="FANNIE_NAMPEYO.png" sizePositionLocked="false" resizeable="true" link="" width="315" locked="" deletable="" WOHratio="0.9948320413436692" fileType="IMAGEFILTER" uniqueID="element79" originalSource="" bucketRatio="0.9948320413436692" imageRatio="0.9948320413436692" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="385" origHeight="387" imageWidth="385" imageHeight="387" groupID="44"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-47" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="15250" bgcolor="" x="245" sizePositionLocked="false" width="225" locked="" deletable="" uniqueID="element80" groupID="44"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">FANNIE NAMPEYO, 5 X 8 IN</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-48" templateID="" height="273" editable="true" type="Text" border-width="0" padding="0" y="15352" bgcolor="" x="106" sizePositionLocked="false" width="1242" locked="" deletable="" uniqueID="element81"><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">SANTA CLARA</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The mesa ruins of Puye are remains from Anasazi settlements that were built on Santa Clara land. About 1500, the Puye settlers joined the people of the Rio Grande, where they met with Coronado's soldiers in 1540, built a mission by 1640 which was burned by 1680. After 1692, these remaining people joined the San Ildefonso clan on Black Mesa and were able to hold off the Spanish until 1696. But, they fell again, and ran off to join forces with the Zuni and Hopi, but by 1702, they returned home to their original territories and built a new mission. Today, the people of Santa Clara live and work in a good relationship with the Hispanic population in the area; they farm, some work in Los Alamos and many make pottery. They have become extremely prolific potters, over 200 potters turning out their very famous black ware and red ware at very high prices. When the Smithsonian made their expeditions in the late 1800's, they were purchasing undecorated black and red storage jars. The famous Bear Claw design of the Santa Clara pueblo did not become wide spread on their ware until about the 1900's. What changed their production was the railroad and tourists. The Santa Clara potters began producing multitudes of small pieces for the tourist trade. These pots were functional, such as pitchers, vases, cups, even some animal figurines, boosting their economy and putting the pueblo on the map of great southwest pottery.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-31" templateID="" alt="" height="371" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="14907" x="1007" src="FANNY_NAMPEYO.png" sizePositionLocked="false" resizeable="true" link="" width="253" locked="" deletable="" WOHratio="0.6819407008086253" fileType="IMAGEFILTER" uniqueID="element82" originalSource="" bucketRatio="0.6819407008086253" imageRatio="0.6819407008086253" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="253" origHeight="371" imageWidth="253" imageHeight="371" groupID="25"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-49" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="15284" bgcolor="" x="1050" sizePositionLocked="false" width="142" locked="" deletable="" uniqueID="element83" groupID="25"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">FANNY NAMPEYO</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-32" templateID="" alt="" height="299" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="15908" x="471" src="EARLY_SANTA_CLARA_BLACK_WARE.png" sizePositionLocked="false" resizeable="true" link="" width="439" locked="" deletable="" WOHratio="1.4682274247491638" fileType="IMAGEFILTER" uniqueID="element84" originalSource="" bucketRatio="1.4682274247491638" imageRatio="1.4682274247491638" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="439" origHeight="299" imageWidth="439" imageHeight="299" groupID="26"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-50" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="16212" bgcolor="" x="532" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element85" groupID="26"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">EARLY SANTA CLARA BLACK WARE</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-33" templateID="" alt="" height="379" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="16658" x="874" src="MARGARET_GUTIERREZ.png" sizePositionLocked="false" resizeable="true" link="" width="241" locked="" deletable="" WOHratio="0.634703196347032" fileType="IMAGEFILTER" uniqueID="element86" originalSource="" bucketRatio="0.634703196347032" imageRatio="0.634703196347032" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="278" origHeight="438" imageWidth="278" imageHeight="438" groupID="27"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-51" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="17043" bgcolor="" x="896" sizePositionLocked="false" width="201" locked="" deletable="" uniqueID="element87" groupID="27"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">MARGARET GUTIERREZ</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-34" templateID="" alt="" height="368" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="18899" x="295" src="MARGARET_TAFOYA.png" sizePositionLocked="false" resizeable="true" link="" width="247" locked="" deletable="" WOHratio="0.6699507389162561" fileType="IMAGEFILTER" uniqueID="element88" originalSource="" bucketRatio="0.6699507389162561" imageRatio="0.6699507389162561" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="272" origHeight="406" imageWidth="272" imageHeight="406" groupID="84"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-52" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="19271" bgcolor="" x="332" sizePositionLocked="false" width="170" locked="" deletable="" uniqueID="element89" groupID="84"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">MARGARET TAFOYA</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-35" templateID="" alt="" height="350" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="18144" x="126" src="GRACE_MEDICINE_FLOWER.png" sizePositionLocked="false" resizeable="true" link="" width="291" locked="" deletable="" WOHratio="0.8314285714285714" fileType="IMAGEFILTER" uniqueID="element90" originalSource="" bucketRatio="0.8314285714285714" imageRatio="0.8314285714285714" offsetX="0.006734006734006734" offsetY="0.0014005602240896359" zoom="1.02" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="291" origHeight="350" imageWidth="291" imageHeight="350" groupID="77"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-53" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="18498" bgcolor="" x="154" sizePositionLocked="false" width="226" locked="" deletable="" uniqueID="element91" groupID="77"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">GRACE MEDICINE FLOWER</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-36" templateID="" alt="" height="359" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="18133" x="819" src="JOSEPH_LONEWOLF.png" sizePositionLocked="false" resizeable="true" link="" width="260" locked="" deletable="" WOHratio="0.724233983286908" fileType="IMAGEFILTER" uniqueID="element92" originalSource="" bucketRatio="0.724233983286908" imageRatio="0.724233983286908" offsetX="-0.0056179775280898875" offsetY="0.0027100271002710027" zoom="1.0269230769230768" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="260" origHeight="359" imageWidth="260" imageHeight="359" groupID="82"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-54" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="18497" bgcolor="" x="869" sizePositionLocked="false" width="169" locked="" deletable="" uniqueID="element93" groupID="82"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">JOSEPH LONEWOLF</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-55" templateID="" height="212" editable="true" type="Text" border-width="0" padding="0" y="4395" bgcolor="" x="124" sizePositionLocked="false" width="1238" locked="" deletable="" uniqueID="element94"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">HOHOKAM, 100-1450 PE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Hohokam culture existed in a similar time frame as the Mogollon, also disappearing similarly about 1450 PE. Like their neighboring Mogollon, the Hohokam built large settlements, but did not live in large dense pueblos. Rather, they lived in expansive rancheros, with single family units around the present day area of Snake Town, Phoenix, AZ. While they lived widely dispersed, they only contained an area of 400 acres, with a small population of 500. We might relate to these people as living in a suburbs of a major city, the major sites being settled by the Mogollon. They were farmers with an intricate canal system, developing their lands for over 1000 years. They cremated their dead, leaving no burial sites. Their ware was termed Plainware, representing their Plains area, in a buff clay body with red designs. This coarse pottery was well fired and made excellent cooking vessels. In time they they blended into the Salado and Sinagua people.  </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-37" templateID="" alt="" height="301" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="4639" x="576" src="hohokam_900-1100_az.png" sizePositionLocked="false" resizeable="true" link="" width="304" locked="" deletable="" WOHratio="1.010909090909091" fileType="IMAGEFILTER" uniqueID="element95" originalSource="" bucketRatio="1.010909090909091" imageRatio="1.010909090909091" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="278" origHeight="275" imageWidth="278" imageHeight="275" groupID="31"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-56" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="4946" bgcolor="" x="609" sizePositionLocked="false" width="221" locked="" deletable="" uniqueID="element96" groupID="31"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">HOHOKAM  900-1100 PE, AZ</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-38" templateID="" alt="" height="350" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="11668" x="733" src="LUCY_LEWIS_copy.png" sizePositionLocked="false" resizeable="true" link="" width="386" locked="" deletable="" WOHratio="1.1028571428571428" fileType="IMAGEFILTER" uniqueID="element97" originalSource="" bucketRatio="1.1028571428571428" imageRatio="1.1028571428571428" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="8" contrast="0.22599999999999998" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="386" origHeight="350" imageWidth="386" imageHeight="350" groupID="34"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-57" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="12024" bgcolor="" x="875" sizePositionLocked="false" width="105" locked="" deletable="" uniqueID="element98" groupID="34"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">LUCY LEWIS</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-41" templateID="" alt="" height="365" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="14907" x="657" src="FANNIE_NAMPEYO-2.png" sizePositionLocked="false" resizeable="true" link="" width="229" locked="" deletable="" WOHratio="0.628731343283582" fileType="IMAGEFILTER" uniqueID="element101" originalSource="" bucketRatio="0.628731343283582" imageRatio="0.628731343283582" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="337" origHeight="536" imageWidth="337" imageHeight="536" groupID="39"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-58" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="15276" bgcolor="" x="687" sizePositionLocked="false" width="148" locked="" deletable="" uniqueID="element102" groupID="39"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">FANNIE NAMPEYO</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-59" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="14552" bgcolor="" x="1068" sizePositionLocked="false" width="180" locked="" deletable="" uniqueID="element104" groupID="97"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">DAISY NAMPEYO 1935</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-43" templateID="" alt="" height="385" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="15863" x="121" src="santa_clara.png" sizePositionLocked="false" resizeable="true" link="" width="287" locked="" deletable="" WOHratio="0.7459349593495935" fileType="IMAGEFILTER" uniqueID="element105" originalSource="" bucketRatio="0.7459349593495935" imageRatio="0.7459349593495935" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="367" origHeight="492" imageWidth="367" imageHeight="492" groupID="47"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-60" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="16256" bgcolor="" x="117" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element106" groupID="47"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">SANTA CLARA BLACK CARVED WARE</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-44" templateID="" alt="" height="323" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="18908" x="789" src="MARGARET_TAFOYA-2.png" sizePositionLocked="false" resizeable="true" link="" width="421" locked="" deletable="" WOHratio="1.303405572755418" fileType="IMAGEFILTER" uniqueID="element107" originalSource="" bucketRatio="1.303405572755418" imageRatio="1.303405572755418" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="421" origHeight="323" imageWidth="421" imageHeight="323" groupID="58"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-61" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="19237" bgcolor="" x="908" sizePositionLocked="false" width="163" locked="" deletable="" uniqueID="element108" groupID="58"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">MARGARET TAFOYA</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-45" templateID="" alt="" height="289" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="18158" x="1139" src="j__lonewolf_carving.png" sizePositionLocked="false" resizeable="true" link="" width="274" locked="" deletable="" WOHratio="0.9480968858131488" fileType="IMAGEFILTER" uniqueID="element109" originalSource="" bucketRatio="0.9480968858131488" imageRatio="0.9480968858131488" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="274" origHeight="289" imageWidth="274" imageHeight="289" groupID="81"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-62" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="18452" bgcolor="" x="1134" sizePositionLocked="false" width="286" locked="" deletable="" uniqueID="element110" groupID="81"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">JOSEPH LONEWOLF CARVING POT</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-46" templateID="" alt="" height="283" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="15912" x="968" src="SANTA_CLARA_REDWARE.png" sizePositionLocked="false" resizeable="true" link="" width="486" locked="" deletable="" WOHratio="1.7173144876325088" fileType="IMAGEFILTER" uniqueID="element111" originalSource="" bucketRatio="1.7173144876325088" imageRatio="1.7173144876325088" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="486" origHeight="283" imageWidth="486" imageHeight="283" groupID="50"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-63" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="16202" bgcolor="" x="1105" sizePositionLocked="false" width="204" locked="" deletable="" uniqueID="element112" groupID="50"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">SANTA CLARA REDWARE</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-64" templateID="" height="105" editable="true" type="Text" border-width="0" padding="0" y="15666" bgcolor="" x="103" sizePositionLocked="false" width="1271" locked="" deletable="" uniqueID="element113"><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">In the late 1800's the Santa Clara potters fired their pots in an oxidizing pit fire, to a red color, set aside the ones they wanted to remain red, and then refire the others smothered in cow chips, or cow dung, in a reducing fire to turn them into black ware. The pieces were burnished and were very sophisticated in technique and style. The redware was not as popular as the blackware until about the 1930's when the potters began outlining their polychrome designs in white. By the 1940's they added the grey blue slip that has persisted till today as part of the Santa Clara polychrome redware.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-65" templateID="" height="281" editable="true" type="Text" border-width="0" padding="0" y="16361" bgcolor="" x="79" sizePositionLocked="false" width="1378" locked="" deletable="" uniqueID="element114"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">VAN GUTIERREZ, 1870-1956</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">LELA GUTIERREZ, 1874-1966</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">MARGARET GUTIERREZ, 1936-</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">LUTHER GUTIERREZ, 1911-1987</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The history of the Gutierrez family goes back many generations, with the first potter, Ta-Key-Sane, the great grandfather of Lela Gutierrez, who made pottery for home use. His son then began making more artistic pottery, adding colors to the basic ware. When he died, his son and wife began making pottery together, establishing a husband and wife team, a concept that was to survive through the coming generations. By the time Van began making pottery, his family had many improvements in their lives and their pottery making became their livelihood. When Van married Lela, they made their pots together, Van creating the designs and painting, while Lela made the pots. Then the children, Luther and Margaret continued the family's pottery making, creating some of the most beautiful pottery in the country. With Luther's son and wife, Paul and Dorothy, a different route was established; they started making blackware animal figurines, called mudheads, which are very expressionistic. Their work is very popular today.  </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-47" templateID="" alt="" height="374" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="16671" x="359" src="_____GUTIERREZ_ware.png" sizePositionLocked="false" resizeable="true" link="" width="412" locked="" deletable="" WOHratio="1.1016042780748663" fileType="IMAGEFILTER" uniqueID="element115" originalSource="" bucketRatio="1.1016042780748663" imageRatio="1.1016042780748663" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="412" origHeight="374" imageWidth="412" imageHeight="374" groupID="52"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-66" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="17049" bgcolor="" x="440" sizePositionLocked="false" width="223" locked="" deletable="" uniqueID="element116" groupID="52"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">  GUTIERREZ FAMILY WARE</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-67" templateID="" height="487" editable="true" type="Text" border-width="0" padding="0" y="17157" bgcolor="" x="89" sizePositionLocked="false" width="1315" locked="" deletable="" uniqueID="element117"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">SERAFINA TAFOYA, 1863-1949</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">MARAGARET TAFOYA, 1904-2001</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">   </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">By the 1900's, Sera Fina, or Serafina, was the leading potter in Santa Clara. She was a master of large forms, producing huge storage ollas, storage vessels, that were over thirty inches high. While she worked in the pottery, her husband, Geronimo worked in the fields. By the 1920's, her children were adult age and were also working in pottery. There were several tourist events that provided the Tafoya family with extensive sale venues. Serafina and the Tafoya family were becoming as well known as Maria Martinez in the San Ildefonso pueblo, and there was a thirst for Southwest pottery. Fred Harvey Tours ran limousines from Santa Fe to Santa Clara with enthusiastic buyers. In the 1930's, Serafina and her children were selling their work in Taos and Santa Fe, winning many awards. As World War ll ended, the Tafoyas had a family car which enabled them to sell their work all over the Southwest, and by the 1960's, the Tafoya family, from Serafina down to great-great grandchildren became the most prestigious highly priced family of potters in the Southwest. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Tafoya pottery made a great deal of ware, beginning with Serafina's large ollas. Her work was produced with the highest quality of roundness, smoothness and refinement. Her daughter Margaret, became the most famous of the Tafoya family. She created carved blackware as early as 1922, then moved on to polychrome redware. Her deeply carved black on black pottery generated her great fame. The Bear Claw design, which is synonymous with Santa Clara pottery, is a good luck symbol, because the bears always knew where water was, an essential element to pueblo living. Other symbols on the ware are kiva step, mountains, clear sky and buffalo horn. Margaret is also well known for her large vessels like her mother’s. In the 1960's, Margaret's brother Camilio and his son and daughter, Joseph Lonewolf and Grace Medicine Flower produced intricate miniature pieces, which became the first extremely high priced pottery of the pueblo. Joseph's miniatures have also been cast in solid silver. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Tafoya family is very large, with over 100 direct descendants of Serafina, more than 70 of them being potters. With the family marrying into other families over the generations, there are 150 potters from the Tafoya clan in the Santa Clara pueblo, creating beautiful work with very high standards. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-48" templateID="" alt="" height="306" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="17691" x="255" src="TAFOYA_FAMILY.png" sizePositionLocked="false" resizeable="true" link="" width="462" locked="" deletable="" WOHratio="1.5098039215686274" fileType="IMAGEFILTER" uniqueID="element118" originalSource="" bucketRatio="1.5098039215686274" imageRatio="1.5098039215686274" offsetX="0.0031847133757961785" offsetY="-0.009615384615384616" zoom="1.0194805194805194" rotate="0" brightness="-16" contrast="0.492" colorEffect="tint" tintRed="-0.03" tintGreen="0.05" tintBlue="0.08" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="462" origHeight="306" imageWidth="462" imageHeight="306" groupID="55"/><Element name="Image-49" templateID="" alt="" height="240" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="17724" x="821" src="__MARGARET_AND_SERAFINA_pottery.png" sizePositionLocked="false" resizeable="true" link="" width="413" locked="" deletable="" WOHratio="1.7208333333333334" fileType="IMAGEFILTER" uniqueID="element119" originalSource="" bucketRatio="1.7208333333333334" imageRatio="1.7208333333333334" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="413" origHeight="240" imageWidth="413" imageHeight="240" groupID="56"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-68" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="18005" bgcolor="" x="352" sizePositionLocked="false" width="211" locked="" deletable="" uniqueID="element120" groupID="55"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">TAFOYA FAMILY POTTERY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-69" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="17973" bgcolor="" x="891" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element121" groupID="56"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">MARGARET AND SERAFINA POTTERY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-70" templateID="" height="254" editable="true" type="Text" border-width="0" padding="0" y="18620" bgcolor="" x="65" sizePositionLocked="false" width="1350" locked="" deletable="" uniqueID="element122"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">MARGARET TAFOYA POTTERY</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">As the pottery on the pueblo continued production, several of the young potters began moving the work into a new design aesthetic. As with many artists, when a successful form of art has evolved, new trends surface, giving the upcoming artists an avenue of exploration and a place within the tradition to call their own. Such was the work produced by Joseph Lonewolf and his sister, Grace Medicine Flower at Santa Clara. Now pieces of turquoise and coral were embedded into the surfaces of the ware, and intricate line design, showcasing the artistry of these potters began to appear on their pots. New color to the pottery was also explored, producing a new Sienna ware that is now part of the traditional Santa Clara oeuvre. Some of the more famous of these potters are from the Naranjo family- Elizabeth, Bernice, Karen, Forest and Dusty Naranjo, Jody Fowell, Mela Youngblood and Stephan Baca.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Experimentation with off set shoulders and undecorated forms, and a large body of innovative work have become the new "tradition" of Santa Clara pottery. Some of todays most ingenious potters emanate from this pueblo.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-50" templateID="" alt="" height="303" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="19326" x="507" src="MODERN_S_CLARA.png" sizePositionLocked="false" resizeable="true" link="" width="491" locked="" deletable="" WOHratio="1.6204620462046204" fileType="IMAGEFILTER" uniqueID="element123" originalSource="" bucketRatio="1.6204620462046204" imageRatio="1.6204620462046204" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="491" origHeight="303" imageWidth="491" imageHeight="303" groupID="59"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-71" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="19635" bgcolor="" x="535" sizePositionLocked="false" width="416" locked="" deletable="" uniqueID="element124" groupID="59"><Paragraph align="center"><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">MODERN SANTA CLARA POTTERY WITH EMBEDDED </Segment></Paragraph><Paragraph align="center"><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">TURQUOISE AND SIENNA SLIP</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-72" templateID="" height="296" editable="true" type="Text" border-width="0" padding="0" y="19731" bgcolor="" x="112" sizePositionLocked="false" width="1273" locked="" deletable="" uniqueID="element125"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">SAN ILDEFONSO</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">San Ildefonso's Anasazi's ancestors settled in the area in what is now the Bandelier National Monument, a great tourist attraction near Santa Fe. During the 1300's, the families of the San Ildefonso pueblo moved about a mile near their current site. Again, the Spanish found them in 1593, taxed them and developed their mission building until in 1680, the people joined the rebellion and torched Santa Fe, but they did not burn their mission. Spanish General de Vargas restored the Spanish presence in 1692, but San Ildefonso maintained separate for a few years, moved on to the Black Mesa and held the Spanish off from their new home. The Spanish finally retreated, San Ildefonso came down from the Mesa and dictated a new truce. But then they finally burned their mission, De Vargas sent a larger army and pacified San Ildefonso at gunpoint. They settled down to a new lifestyle. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">With this quiet life, San Ildefonso began concentrating on pottery, and for the next three hundred years began producing some of the most beautifully executed ware from the Southwest. They produced their traditional polychrome ware, adding red to the upper body, and excelled in all areas of production. As the years moved on, they used various other slips, slightly changing the polychrome, but always maintaining their standards. With all this colorful decoration being pursued, everything changed with Maria and Julian Martinez, who learned how to decorate black ware, and suddenly their work was not only some of the best pottery in the country, but became known throughout the world. A new focus on Native American pottery was bourgeoning.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-51" templateID="" alt="" height="260" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="20062" x="573" src="SAN_ILDEFONSO.png" sizePositionLocked="false" resizeable="true" link="" width="404" locked="" deletable="" WOHratio="1.5538461538461539" fileType="IMAGEFILTER" uniqueID="element126" originalSource="" bucketRatio="1.5538461538461539" imageRatio="1.5538461538461539" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0.18799999999999994" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="404" origHeight="260" imageWidth="404" imageHeight="260" groupID="62"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-73" templateID="" height="50" editable="true" type="Text" border-width="0" padding="0" y="20334" bgcolor="" x="620" sizePositionLocked="false" width="347" locked="" deletable="" uniqueID="element127" groupID="62"><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"> </Segment><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">SAN ILDEFONSO PUEBLO POTTERY</Segment><Segment color="#000000" font-size="10" font-family="Helvetica"> PUEBLO POTTERY</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-74" templateID="" height="718" editable="true" type="Text" border-width="0" padding="0" y="20394" bgcolor="" x="103" sizePositionLocked="false" width="1256" locked="" deletable="" uniqueID="element128"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">MARIA MARTINEZ, 1888-1980</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">JULIAN MARTINEZ, 1885-1943</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">By the time Maria was born, her pueblo was in decline. Pottery making was almost gone as inexpensive Spanish tinware replaced pottery for cooking items in the home. Maria's aunt, Nicolasa Montoya was one of the last of the great San Ildefonso potters of that time. Maria grew up watching her aunt make pottery, and by the age of 7, was making pots. Maria was invited to demonstrate her skills at the St. Louis Worlds Fair. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">She was already engaged to Julian Martinez, and the couple went to Missouri on the afternoon of their wedding day. At the fair, Maria made and fired her pots, and Julian painted his watercolors, as well as demonstrating pueblo dance customs for people all over the world. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Julian's artistic skills developed with the revival of ancient Pueblo mythological creatures, and he evolved into a great painter of San Ildefonso traditions. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Maria and Julian were making beautiful Santa Clara polychrome ware, and were becoming well known for their work. Then, Edgar Hewett, an archaeologist and anthropologist from the the Museum of New Mexico, found some black shards at San Ildefonso during one his excavations on the pueblo. He was fascinated by these and asked Maria if she could make pottery that looked like these shards. By the winter of 1919-20, Maria and Julian rediscovered the techniques that would produce this black ware, and began making their now famous, black on black pottery. Black on Black pottery is ware that has images that lay in both matt and shiny patterns.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">When Hewett asked Maria to work on the black pottery, it was at a time when Julian had already been excavating the area, finding those same shards. By this time he had already developed an interest in this black ware. He kept a sketchbook of the found designs which he showed to Maria; Maria then asked her husband to join her in this new enterprise, which began their legendary collaboration of potter and painter. This new development created great economic changes for the Martinez family as well as the San Ildefonso pueblo as a whole. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Maria and Julian continued to refine their pottery techniques and within a few years were known as the best potters in the area. Maria is distinguished as a technical genius with pots of exceptional symmetry, even thick walls and perfectly unblemished polished surfaces. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Julian was excelling in his painterly influence on Maria's pots. He adapted his prehistoric decorations within a contemporary format. His designs were based on the Avanyu, or the horned water serpent and the Mimbres feather patterns, both of which became synonymous with this new Santa Clara blackware of black highly polished surfaces juxtaposed with matte areas. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Maria and Julian's black on black pottery became a huge financial success. Soon Maria had to train others in her family to produce the ware, but few were able to achieve her incredible highly polished surfaces and Julians' designs. By the 1930's, Maria was world famous, and her legendary pots put San Ildefonso on the map as a great pottery center of the United States. Maria worked with Julian until he died in 1943, then she worked with daughter- in- law Santana Roybal Martinez, until her death in 1956. Maria continued working with with her son, Popovi Da, until his death in 1971. Later on his son, Tony Da became famous with his black and sienna ware, which required a very difficult firing technique. Others now fire this way, making sienna and black pottery typical of San Ildefonso. </Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-52" templateID="" alt="" height="329" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="21193" x="134" src="Maria_Martinez_.png" sizePositionLocked="false" resizeable="true" link="" width="344" locked="" deletable="" WOHratio="1.0455927051671732" fileType="IMAGEFILTER" uniqueID="element129" originalSource="" bucketRatio="1.0455927051671732" imageRatio="1.0455927051671732" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="344" origHeight="329" imageWidth="344" imageHeight="329" groupID="101"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-75" templateID="" height="70" editable="true" type="Text" border-width="0" padding="0" y="21529" bgcolor="" x="106" sizePositionLocked="false" width="413" locked="" deletable="" uniqueID="element130" groupID="101"><Paragraph align="center"><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">MARIA MARTINEZ BLACK ON BLACK PAINTED WARE</Segment></Paragraph><Paragraph align="center"><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">Photo Courtesy of Mark Sublette Medicine Man Gallery Inc. Tucson- Santa Fe, NM</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-53" templateID="" alt="" height="329" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="21193" x="944" src="MARIA_AND_JULIAN.png" sizePositionLocked="false" resizeable="true" link="" width="412" locked="" deletable="" WOHratio="1.2522796352583587" fileType="IMAGEFILTER" uniqueID="element131" originalSource="" bucketRatio="1.2522796352583587" imageRatio="1.2522796352583587" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="412" origHeight="329" imageWidth="412" imageHeight="329" groupID="102"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-76" templateID="" height="54" editable="true" type="Text" border-width="0" padding="0" y="21528" bgcolor="" x="935" sizePositionLocked="false" width="440" locked="" deletable="" uniqueID="element132" groupID="102"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">MARIA AND JULIAN MARTINEZ POLYCHROME POTTERY</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">Photo Courtesy of Mark Sublette Medicine Man Gallery Inc. Tucson- Santa Fe, NM</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-54" templateID="" alt="" height="268" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="21660" x="253" src="Maria_and_Popovi_.png" sizePositionLocked="false" resizeable="true" link="" width="359" locked="" deletable="" WOHratio="1.3377483443708609" fileType="IMAGEFILTER" uniqueID="element133" originalSource="" bucketRatio="1.3377483443708609" imageRatio="1.3377483443708609" offsetX="0.004807692307692308" offsetY="-0.001607717041800643" zoom="1.0297029702970297" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="404" origHeight="302" imageWidth="404" imageHeight="302" groupID="99"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-77" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="21939" bgcolor="" x="277" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element134" groupID="99"><Paragraph><Segment color="#FDEDC0" font-size="10" font-family="Helvetica">MARIA AND POPOVI POLYCHROME</Segment><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">, 1960</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-55" templateID="" alt="" height="314" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="21658" x="969" src="Tony_Da.png" sizePositionLocked="false" resizeable="true" link="" width="341" locked="" deletable="" WOHratio="1.0853658536585367" fileType="IMAGEFILTER" uniqueID="element135" originalSource="" bucketRatio="1.0853658536585367" imageRatio="1.0853658536585367" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="356" origHeight="328" imageWidth="356" imageHeight="328" groupID="100"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-78" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="21981" bgcolor="" x="1014" sizePositionLocked="false" width="283" locked="" deletable="" uniqueID="element136" groupID="100"><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica">   </Segment><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">TONY DA INCISED SIENNA WARE </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-56" templateID="" alt="" height="295" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="22095" x="800" src="MARTINEZ_FAMILY.png" sizePositionLocked="false" resizeable="true" link="" width="297" locked="" deletable="" WOHratio="1.006779661016949" fileType="IMAGEFILTER" uniqueID="element137" originalSource="" bucketRatio="1.006779661016949" imageRatio="1.006779661016949" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="297" origHeight="295" imageWidth="297" imageHeight="295" groupID="69"/><Element name="Image-57" templateID="" alt="" height="347" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="22062" x="387" src="_MARTINEZ_FAMILY.png" sizePositionLocked="false" resizeable="true" link="" width="295" locked="" deletable="" WOHratio="0.8501440922190202" fileType="IMAGEFILTER" uniqueID="element138" originalSource="" bucketRatio="0.8501440922190202" imageRatio="0.8501440922190202" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="295" origHeight="347" imageWidth="295" imageHeight="347" groupID="69"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-79" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="22440" bgcolor="" x="631" sizePositionLocked="false" width="249" locked="" deletable="" uniqueID="element139" groupID="69"><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica">   </Segment><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">MARTINEZ FAMILY POTTERY</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-80" templateID="" height="306" editable="true" type="Text" border-width="0" padding="0" y="22550" bgcolor="" x="133" sizePositionLocked="false" width="1211" locked="" deletable="" uniqueID="element140"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">THE MODERN ERA </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">SOUTHWEST NATIVE AMERICAN POTTERS, 14th- 19th Century</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">ROSE GONZALES, 1900-1989</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Rose Gonzaless was another potter of influence from San Ildefonso. While Maria made her name with the painted black on black pottery, Rose became famous with her deeply carved black ware. Her son, Tse-Pe also contributed to this great lineage of potters. At the time Rose was working, carved blackware was being produced at the Santa Clara pueblo, but Rose's work was unique in style. Her more shallow carved edges were rounded and the incised designs were intentionally textured as well as polished in certain areas. This subtle difference makes Rose's pottery more bulbous and softer in appearance. Tse-Pe and his wife followed Roses' work, but as most younger potters do, they experimented with their own stylistic effects. After they divorced, Tse-Pe remarried Jennifer, who also became a signifiant potter. This younger generation worked with odd shapes, inlays, unusual slips in blue, green and even metallic bronze.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-58" templateID="" alt="" height="343" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="21193" x="601" src="MARIA_M.png" sizePositionLocked="false" resizeable="true" link="" width="250" locked="" deletable="" WOHratio="0.7298747763864043" fileType="IMAGEFILTER" uniqueID="element141" originalSource="" bucketRatio="0.7298747763864043" imageRatio="0.7298747763864043" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="408" origHeight="559" imageWidth="408" imageHeight="559" groupID="70"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-81" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="21545" bgcolor="" x="645" sizePositionLocked="false" width="147" locked="" deletable="" uniqueID="element142" groupID="70"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">MARIA MARTINEZ</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-59" templateID="" alt="" height="313" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="22926" x="318" src="GONZALES.png" sizePositionLocked="false" resizeable="true" link="" width="376" locked="" deletable="" WOHratio="1.2012779552715656" fileType="IMAGEFILTER" uniqueID="element143" originalSource="" bucketRatio="1.2012779552715656" imageRatio="1.2012779552715656" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="376" origHeight="313" imageWidth="376" imageHeight="313" groupID="73"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-82" templateID="" height="90" editable="true" type="Text" border-width="0" padding="0" y="23245" bgcolor="" x="350" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element144" groupID="73"><Paragraph align="center"><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">GONZALES FAMILY POTTERY, ROSE GONZALES BLACK CARVED POT IN UPPER RIGHT </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-60" templateID="" alt="" height="342" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="22926" x="843" src="ROSE_GONZALES.png" sizePositionLocked="false" resizeable="true" link="" width="227" locked="" deletable="" WOHratio="0.6637426900584795" fileType="IMAGEFILTER" uniqueID="element145" originalSource="" bucketRatio="0.6637426900584795" imageRatio="0.6637426900584795" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="227" origHeight="342" imageWidth="227" imageHeight="342" groupID="74"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-83" templateID="" height="18" editable="true" type="Text" border-width="0" padding="0" y="23278" bgcolor="" x="884" sizePositionLocked="false" width="147" locked="" deletable="" uniqueID="element146" groupID="74"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">ROSE GONZALES</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-84" templateID="" height="233" editable="true" type="Text" border-width="0" padding="0" y="23399" bgcolor="" x="120" sizePositionLocked="false" width="1213" locked="" deletable="" uniqueID="element147"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">SANTO DOMINGO</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Santo Domingo is a large pueblo stretching over one hundred square miles across the Rio Grande, NM, with a population of over twenty five hundred. The pueblo is actually known for its jewelry making rather than pottery, but some historic potters sprang from this pueblo. The Indian name of the town is "Guipi", meaning, the unknown. They are relatively quiet and don't encourage tourists. In its history, floods kept destroying the settlement in 1606, 1700 and 1855, each time the people moved to higher ground. After the 1680 revolt, many of the people fled west and helped establish the Laguna Pueblo. From the late 1800's on, the pueblo made black on red and cream polychrome pottery. As the blackware pottery became well known throughout the pueblos, the Santo Domingo potters followed suit, and produced their own version of blackware with distinctive Santo Domingo flowers and leaves as their basic design. Their pottery was not highly prized at that time, but that soon changed. After World War ll, pottery kept diminishing at the pueblo, with their jewelry becoming more sought after. But the potters kept on working, keeping the tradition of pottery making alive.  </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-61" templateID="" alt="" height="330" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="23676" x="589" src="SANTO_DOMINGO.png" sizePositionLocked="false" resizeable="true" link="" width="286" locked="" deletable="" WOHratio="0.8666666666666667" fileType="IMAGEFILTER" uniqueID="element148" originalSource="" bucketRatio="0.8666666666666667" imageRatio="0.8666666666666667" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="286" origHeight="330" imageWidth="286" imageHeight="330" groupID="75"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-85" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="24014" bgcolor="" x="602" sizePositionLocked="false" width="265" locked="" deletable="" uniqueID="element149" groupID="75"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"> OLD SANTO DOMINGO POTTERY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-86" templateID="" height="170" editable="true" type="Text" border-width="0" padding="0" y="24100" bgcolor="" x="117" sizePositionLocked="false" width="1207" locked="" deletable="" uniqueID="element150"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">ROBERT TENORIO, 1950-</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Andrea Ortiz was a potter whose family excelled in jewelry. She allowed her jeweler daughter Juanita to paint on her pottery, and also allowed her grandson, Robert, to work in clay. He attended the Institute of American Indian Arts to become a jeweler with his family, but he was more interested in the pottery division. By the 1970's, Robert was making work that started to attract attention. During the 1980's Robert convinced his sisters and then the whole family to make pottery, which they did, becoming award winning potters. The Tenorio family brought the Santo Domingo pottery tradition back to life, with Robert Tenorio leading the way to great fame.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-62" templateID="" alt="" height="265" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="24318" x="508" src="TENORIO.png" sizePositionLocked="false" resizeable="true" link="" width="445" locked="" deletable="" WOHratio="1.679245283018868" fileType="IMAGEFILTER" uniqueID="element151" originalSource="" bucketRatio="1.679245283018868" imageRatio="1.679245283018868" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="445" origHeight="265" imageWidth="445" imageHeight="265" groupID="76"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-87" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="24592" bgcolor="" x="607" sizePositionLocked="false" width="222" locked="" deletable="" uniqueID="element152" groupID="76"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">TENORIO FAMILY POTTERY</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-88" templateID="" height="653" editable="true" type="Text" border-width="0" padding="0" y="24688" bgcolor="" x="147" sizePositionLocked="false" width="1212" locked="" deletable="" uniqueID="element153"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">NAVAJO TRIBE</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Navajos are the largest tribe in the Southwest. Their population of over 200,000 covers land that extends from Arizona, New Mexico and Utah. The Navajos call themselves "Dine", or, "the people". They probably migrated from areas in Canada into northern New Mexico around 1300-1400 PE, settling in the area known as "Dinetah", dwelling in high mesas and deep canyons. Their early sites are found at Gobernador and Largo Canyons, where they became an agrarian people.  </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">They had many disputes with the residing pueblos in the area, specifically the Utes, which eventually led the Navajos to abandon that area, and settle down more westerly. Again, the Spanish changed everything for the Navajos, making them pay tribute in manufactured goods and agricultural produce. When the big revolt of 1860 occurred, the Navajo tribe joined forces with the pueblos to remove the Spanish, which, lasted only for awhile. In 1692, Spanish rule was reestablished, and many pueblos took refuge in Navajo lands; we saw this same situation with the Hopis, who today still reside within the Navajo Reservation. The Navajos originally did not excel in pottery, rather they became great weavers when they adopted the pueblo looms. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">During the second half of the 1700's, Spanish influence became greater in all the territories of the Southwest. In 1821, Mexico won their independence from Spain, and all of New Mexico and its inhabitants came under Mexican rule. A policy of Indian slavery escalated and the Navajos became the Mexicans main targets. Mexican rule ended in 1846 when the northern frontiers were ceded to the U.S., and within the American expansion more frontier conflicts developed between the Indians and the ranchers. By the 1860's there was open warfare, and after several treaties, in 1864, around 9,000 Navajo men, women and children were forced to embark upon a march to Fort Sumner. This has become known as "The Long Walk", a trek of over 300 miles from their homeland to Fort Sumner, in southeastern New Mexico.  </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Navajos endured living at the Fort for four years, where after much crop failure, disease, and death, the fort was closed in 1868. In a new treaty, a small tract of land in the original Navajo territory was set aside for Navajo settlement, and surviving Navajos returned home. Rations and some provisions were given to the Navajos, but this was considered the most bitter period in Navajo history.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The Navajo Reservation grew in population as they became familiar with the Trading Post, a way for them the sell their goods. As their community grew, they, alongside all the pueblos in the Southwest, struggled with how to maintain their identity within the modern world.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">As the Navajos emerged into the twentieth century, so did their pottery. Initially their wares were undecorated utility pieces made by a few families. The leaders of the Trading Posts told the Navajos to start making new pottery to sell alongside their pueblo neighbors, who were creating polychrome decorated ware; their pottery was considered second to their outstanding rugs and jewelry. Soon Navajo pottery developed into beautiful complex vessels, and today's contemporary potters are joining the traditions of the great potters of the Southwest.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-64" templateID="" alt="" height="327" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="18157" x="493" src="grace_medicine_flower-2.png" sizePositionLocked="false" resizeable="true" link="" width="247" locked="" deletable="" WOHratio="0.7549407114624506" fileType="IMAGEFILTER" uniqueID="element155" originalSource="" bucketRatio="0.7549407114624506" imageRatio="0.7549407114624506" offsetX="0.012626262626262626" offsetY="0.013358778625954198" zoom="1.0355731225296443" rotate="0" brightness="22" contrast="0.492" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="191" origHeight="253" imageWidth="191" imageHeight="253" groupID="83"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-89" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="18497" bgcolor="" x="471" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element156" groupID="83"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">GRACE MEDICINE FLOWER POTERY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-65" templateID="" alt="" height="235" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="25466" x="165" src="BERTHA_AND_SILAS_CLAW.png" sizePositionLocked="false" resizeable="true" link="" width="431" locked="" deletable="" WOHratio="1.8340425531914895" fileType="IMAGEFILTER" uniqueID="element157" originalSource="" bucketRatio="1.8340425531914895" imageRatio="1.8340425531914895" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="431" origHeight="235" imageWidth="431" imageHeight="235" groupID="85"/><Element name="Image-66" templateID="" alt="" height="266" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="25474" x="674" src="ALICE_CLING.png" sizePositionLocked="false" resizeable="true" link="" width="199" locked="" deletable="" WOHratio="0.7470817120622568" fileType="IMAGEFILTER" uniqueID="element158" originalSource="" bucketRatio="0.7470817120622568" imageRatio="0.7470817120622568" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="192" origHeight="257" imageWidth="192" imageHeight="257" groupID="86"/><Element name="Image-67" templateID="" alt="" height="387" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="25389" x="995" src="LUCY_McKELVEY.png" sizePositionLocked="false" resizeable="true" link="" width="264" locked="" deletable="" WOHratio="0.6821705426356589" fileType="IMAGEFILTER" uniqueID="element159" originalSource="" bucketRatio="0.6821705426356589" imageRatio="0.6821705426356589" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="264" origHeight="387" imageWidth="264" imageHeight="387" groupID="87"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-90" templateID="" height="28" editable="true" type="Text" border-width="0" padding="0" y="25712" bgcolor="" x="267" sizePositionLocked="false" width="214" locked="" deletable="" uniqueID="element160" groupID="85"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">BERTHA AND SILAS CLAW</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-91" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="25746" bgcolor="" x="710" sizePositionLocked="false" width="112" locked="" deletable="" uniqueID="element161" groupID="86"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">ALICE CLING</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-92" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="25784" bgcolor="" x="1050" sizePositionLocked="false" width="138" locked="" deletable="" uniqueID="element162" groupID="87"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">LUCY McKELVEY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-93" templateID="" height="1052" editable="true" type="Text" border-width="0" padding="0" y="25894" bgcolor="" x="140" sizePositionLocked="false" width="1258" locked="" deletable="" uniqueID="element163"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">ZUNI PUEBLO</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The last pueblo that will be discussed is the Zuni Pueblo, which is actually first area the Spanish entered in the Southwest. In 1539, Coronado went to Zuni in hopes of reaching gold, but instead conquered them in less than an hour. Zuni revolted in 1632, losing the fight. They revolted again in the Great Revolt of 1680, but to no avail, fleeing into the hills. They finally came down and surrendered; they had been attacked by the Apache, and decided that Spanish rule was better than Apache slaughter. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Today, Zuni has entered the Modern age, quietly moving towards the future. It was such a wonderful experience for me and my husband, when we spent three days at Zuni. In Zuni there is a fabulous B&amp;B, The Inn at Halona, run by Frenchman, Roger Thomas. Zuni is one of the few pueblos that has commercial lodging that allows guests to stay inside the pueblo. The B&amp;B was quite beautiful and many Zunis make their livelihood from the B&amp;B and attached grocery. We had the opportunity to meet several residents, and totally enjoyed their hospitality, generosity and graciousness. My host, Roger is very involved in local governing, and knew everyone in the pueblo. Knowing I was a potter, he organized meetings with two of the best known potters in Zuni for me to meet. My time spent with these exceptional people was wondrous; their lifestyle is so different than mine, yet we spoke the same language-CLAY. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Traditional Zuni ware has a pink hue to the clay body, and their black clay slip is actually brown, which is also the main color of their ware. Pre 1930 ware is very precious and highly priced, yet many pots were simply functional home ware. By the 1950, Zuni pottery was in decline, and most Zuni's were producing jewelry. Then the Zuni High School began their pottery classes, and due to several generations of teachers, the great pottery tradition took hold once again. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">The first of these teachers was Daisy Hooee, granddaughter of Hopi's, Nampeyo. She married a Zuni man, moved to Zuni and taught at the High School. After Daisy, the pottery classes were taken over by Jennie Laate from Acoma, after she also married and moved to Zuni. In 1985 Josephine Nahohai received a fellowship to teach pottery making. In 1986 The Zuni Tribal Arts &amp; Crafts enterprise sent six Zuni potters to the Smithsonian to view historic Zuni pots. Immediately upon returning home, they were excited to produce and teach pottery. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">In the 1990's, Noreen Simplico ran the High School pottery classes, continuing the traditions that she learned there as a child. Noreen was one of the two potters that I met. Her studio in her home shows examples of her beautiful ware, but there is something new in her studio. Noreen creates both traditional and contemporary pottery.  </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Like so many other Zuni potters, she and her husband drive up into the hills with buckets in their truck. There they dig the precious clay, bringing down buckets of it from the mountain. Once home, they prepare the clay in the traditional ways, and Noreen then makes her pots with ancient coil building methods. She then paints, sculpts additive figurines onto her elaborate forms and fires them in traditional pit fires.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">But next to her table of beautiful hand made vessels is her shiny metal electric kiln! On a desk near her clay making area resides her computer, which enables her fingers to reach outside the pueblo. Her world resides between the old and the new. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">Her electric fired work helps her make a living. As we talked, I realized that this is no different than many potters I know, who have a "bread and butter" line and then take time to create their one of a kind vessels or sculptures. Noreen's mugs, jars and other forms are slip casted molds that she purchases along with her commercial slips and stains for painting her designs. Her amazing paintings dance along her pieces, and she believes that her painting is what is mostly unique to her commercially formulated ware. On a separate table are her hand built vessels, which I also saw at the Trading Post in town as well as in other galleries, as she is quite well known. She is famous for her sculpted figures which run across the shoulders, neck and covers of her forms. We talked for two hours and I began to understand what had finally changed in the Southwest. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">I also saw electric fired ware at the Acoma pueblo. When I was up in Sky City, where there is no electricity or water, there were potters that were selling their ware on tables outside their homes. Some of this work was fired in electric kilns. They get their commercial clays and slips, drive them up to Sky City, make their ware, then drive them down to the main Acoma pueblo where other potters have shared kilns to fire their wares. Alongside this new electric kiln fired ware are traditionally produced Acoma vessels made in the old ways, in pit fires. </Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">I also met Anderson and Avelia Peynetsa. Anderson became one of Zuni's premier potters, sharing his art form with several family members. Now he works solely with his wife, Avelia. At Zuni High, young potters learn about greenware, commercial slips and the electric kiln. Anderson and Avelia dig their own clay and produce their vessels with elaborately painted designs. However like most Zuni and Acoma potters today, they fire their ware in electric kilns, rather than risk the breakage of the pit fires. There is much discussion to this change in pueblo made pottery, and these artists see themselves as both traditional and contemporary. While this discussion will continue for many more years, the work produced by these brilliant potters is breathtaking!  </Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-68" templateID="" alt="" height="300" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="27917" x="586" src="OLD_ZUNI_MISSION.JPG" sizePositionLocked="false" resizeable="true" link="" width="451" locked="" deletable="" WOHratio="1.5037593984962405" fileType="IMAGEFILTER" uniqueID="element164" originalSource="" bucketRatio="1.5037593984962405" imageRatio="1.5037593984962405" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="532" imageWidth="800" imageHeight="532" groupID="92"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-94" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="28224" bgcolor="" x="721" sizePositionLocked="false" width="172" locked="" deletable="" uniqueID="element165" groupID="92"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">OLD ZUNI MISSION</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-69" templateID="" alt="" height="461" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="27377" x="322" src="ZUNI_B_B.jpg" sizePositionLocked="false" resizeable="true" link="" width="307" locked="" deletable="" WOHratio="0.665" fileType="IMAGEFILTER" uniqueID="element166" originalSource="" bucketRatio="0.665" imageRatio="0.665" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="532" origHeight="800" imageWidth="532" imageHeight="800" groupID="96"/><Element name="Image-70" templateID="" alt="" height="331" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="27384" x="698" src="ZUNI_B_B-2.JPG" sizePositionLocked="false" resizeable="true" link="" width="498" locked="" deletable="" WOHratio="1.5037593984962405" fileType="IMAGEFILTER" uniqueID="element167" originalSource="" bucketRatio="1.5037593984962405" imageRatio="1.5037593984962405" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="532" imageWidth="800" imageHeight="532" groupID="96"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-95" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="27757" bgcolor="" x="734" sizePositionLocked="false" width="338" locked="" deletable="" uniqueID="element168" groupID="96"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">INN AT HALONA, ZUNI B&amp;B GUEST HOUSE</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-71" templateID="" alt="" height="272" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="27001" x="568" src="TRADITIONAL_ZUNI.png" sizePositionLocked="false" resizeable="true" link="" width="388" locked="" deletable="" WOHratio="1.4264705882352942" fileType="IMAGEFILTER" uniqueID="element169" originalSource="" bucketRatio="1.4264705882352942" imageRatio="1.4264705882352942" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="388" origHeight="272" imageWidth="388" imageHeight="272" groupID="91"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-96" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="27283" bgcolor="" x="632" sizePositionLocked="false" width="244" locked="" deletable="" uniqueID="element170" groupID="91"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">TRADITIONAL ZUNI POTTERY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-72" templateID="" alt="" height="402" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="28290" x="195" src="NOREEN_SIMPLICO.png" sizePositionLocked="false" resizeable="true" link="" width="316" locked="" deletable="" WOHratio="0.7853260869565217" fileType="IMAGEFILTER" uniqueID="element171" originalSource="" bucketRatio="0.7860696517412935" imageRatio="0.7853260869565217" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0.264" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="289" origHeight="368" imageWidth="289" imageHeight="368" groupID="93"/><Element name="Image-73" templateID="" alt="" height="312" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="28333" x="564" src="ANDERSON_PEYNETSA.png" sizePositionLocked="false" resizeable="true" link="" width="329" locked="" deletable="" WOHratio="1.0544871794871795" fileType="IMAGEFILTER" uniqueID="element172" originalSource="" bucketRatio="1.0544871794871795" imageRatio="1.0544871794871795" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="329" origHeight="312" imageWidth="329" imageHeight="312" groupID="94"/><Element name="Image-74" templateID="" alt="" height="317" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="28330" x="956" src="ANDERSON_PEYNETSA_VESSELS.JPG" sizePositionLocked="false" resizeable="true" link="" width="477" locked="" deletable="" WOHratio="1.5037593984962405" fileType="IMAGEFILTER" uniqueID="element173" originalSource="" bucketRatio="1.5029761904761905" imageRatio="1.5037593984962405" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="60" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="532" imageWidth="800" imageHeight="532" groupID="94"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-97" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="28699" bgcolor="" x="262" sizePositionLocked="false" width="156" locked="" deletable="" uniqueID="element174" groupID="93"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">NOREEN SIMPLICO</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-98" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="28686" bgcolor="" x="789" sizePositionLocked="false" width="260" locked="" deletable="" uniqueID="element175" groupID="94"><Paragraph><Segment color="#FDEDC0" font-size="12" font-family="Helvetica">ANDERSON PEYNETSA VESSELS</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-99" templateID="" height="296" editable="true" type="Text" border-width="0" padding="0" y="28820" bgcolor="" x="143" sizePositionLocked="false" width="1208" locked="" deletable="" uniqueID="element176"><Paragraph><Segment color="#FDEDC0" font-size="16" font-family="Helvetica">IN CONCLUSION</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">In most of our contemporary ceramic circles, we have finally moved on to acknowledge all kinds of ceramic production as "handmade", exhibiting high levels of artistry and craftsmanship. There are so many kinds of innovative methods in the production of ceramics, that we now look at the quality of the work, rather than just how it is made. I learned from Voulkos that a vessel or a clay sculpture doesn't have to have a glaze on it to be considered a ceramic work of art. After all, he used lacquer paint to decorate many of his plates. No one today questions the validity of his work. I moved into patinas in place of traditional glazes on many of my ceramic wall pieces and sculptures, never thinking they are any less ceramic than those finished with fired glazes. The act of rubbing patinas onto my clay surfaces is in fact for me very similar to the ancient potters of the Southwest, who burnished and polished different colored slips onto their wares.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica"/></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="14" font-family="Helvetica">So ends this discussion of our Southwest Native American potters. The story of our country's ceramic origins is great and vast, as I only touched upon one facet of our heritage. As we learn more about the contribution of so many of our nation's ancestors, we begin to see the enormously varied art form of what we call American Pottery. Our ceramic tradition goes back centuries and tells a story of not only the unique complexity of ceramic work produced in our country, but the continual unfolding legacy of the diverse American profile. </Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element link="index.html" width="77" WOHratio="0.5" y="29159" type="ImportedImage" x="519" alt="" deletable="" editable="true" originalSource="" name="Add an Image-87" sizePositionLocked="false" height="153" templateID="" locked="" fileType="IMAGEFILTER" link_target="_self" uniqueID="element180" isImageType="true" resizeable="true" maintainProportion="true" src="new_logo.jpg" bucketRatio="0.5" imageRatio="0.5" offsetX="0" offsetY="0" zoom="1" editMode="normalMode" origWidth="137" origHeight="274" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" groupID="95"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-100" templateID="" height="29" editable="true" type="Text" border-width="0" padding="0" y="29228" bgcolor="" x="494" sizePositionLocked="false" width="137" locked="" deletable="" uniqueID="element181" groupID="95"><Paragraph><Segment color="#406AB0" font-size="16" font-family="Helvetica" font-style="bold" href="index.html" link_target="_self">HOME PAGE</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-101" templateID="" height="42" editable="true" type="Text" border-width="0" padding="0" y="29219" bgcolor="" x="721" sizePositionLocked="false" width="258" locked="" deletable="" uniqueID="element182"><Paragraph align="center"><Segment color="#406AB0" font-size="14" font-family="Helvetica" font-style="bold" href="HISTORY.html" link_target="_self">RETURN TO MOMENTS IN CERAMIC HISTORY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-75" templateID="" alt="" height="249" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="14295" x="1025" src="Daisy_Nampeyo.jpeg" sizePositionLocked="false" resizeable="true" link="" width="265" locked="" deletable="" WOHratio="1.0623556581986142" fileType="IMAGEFILTER" uniqueID="element183" originalSource="" bucketRatio="1.0623556581986142" imageRatio="1.0623556581986142" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="460" origHeight="433" imageWidth="460" imageHeight="433" groupID="97"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-102" templateID="" height="48" editable="true" type="Text" border-width="0" padding="0" y="21799" bgcolor="" x="638" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element184" groupID="100"><Paragraph><Segment color="#FDEDC0" font-size="10" font-family="Helvetica">Both of these photos are the Photo Courtesy of Mark Sublette Medicine Man Gallery Inc. Tucson- Santa Fe, NM</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Form resizeable="no" height="auto" width="100%" y="" x=""/></Element><HeadTag><![CDATA[
    
