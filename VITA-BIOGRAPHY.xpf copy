ght="107" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="1036" x="456" src="new_logo.jpg" sizePositionLocked="false" resizeable="true" link="index.html" width="54" locked="" deletable="" WOHratio="0.5" fileType="IMAGEFILTER" uniqueID="element7" originalSource="" bucketRatio="0.5" imageRatio="0.5" offsetX="0" offsetY="0" zoom="1" editMode="normalMode" origWidth="137" origHeight="274" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" groupID="1"/><Element name="Image-17" templateID="" alt="" height="107" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="1033" x="780" src="new_logo.jpg" sizePositionLocked="false" resizeable="true" link="ARTIST-VITAE.html" width="54" locked="" deletable="" WOHratio="0.5" fileType="IMAGEFILTER" uniqueID="element8" originalSource="" bucketRatio="0.5" imageRatio="0.5" offsetX="0" offsetY="0" zoom="1" editMode="normalMode" origWidth="137" origHeight="274" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" groupID="3"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-3" templateID="" height="38" editable="true" type="Text" border-width="0" padding="0" y="1147" bgcolor="" x="406" sizePositionLocked="false" width="154" locked="" deletable="" uniqueID="element10" groupID="1"><Paragraph><Segment color="#000066" font-size="12" font-family="Times New Roman" font-style="bold" href="index.html" link_target="_self">GO TO HOMEPAGE</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-4" templateID="" height="38" editable="true" type="Text" border-width="0" padding="0" y="1145" bgcolor="" x="712" sizePositionLocked="false" width="198" locked="" deletable="" uniqueID="element11" groupID="3"><Paragraph><Segment color="#000066" font-size="12" font-family="Times New Roman" font-style="bold" href="ARTIST-VITAE.html" link_target="_self">GO TO PREVIOUS PAGE</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-5" templateID="" height="550" editable="true" type="Text" border-width="0" padding="0" y="277" bgcolor="" x="87" sizePositionLocked="false" width="1089" locked="" deletable="" uniqueID="element12"><Paragraph><Segment color="#000000" font-size="16" font-family="Times New Roman">Jayne E. Shatz, artist, educator, ceramic historian, conference and video producer, holds a PhD in Ceramic History, Prehistoric Ceramics, an MA in Pottery and Sculpture and a BA in Art History. For 50 years, Jayne has built a reputation as an artist, educator and writer. She began her ceramic career in the 1970’s at the Kilnhaus Potters in NY. In 1979 she became the Director of Ceramics</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="16" font-family="Times New Roman">for the State University of NY Albany’s College of Continuing Studies. In 1982 she founded The Albany Ceramic Institute and the Frances Simches Gallery. In 1984 she become the Director of Ceramics for the Hudson Valley Community College/Art Center in Troy, NY. During that time she co-founded the Hudson River Clay Factory Cooperative. Jayne maintained a ceramic and sculpture daytime teaching position at Shenendehowa High School for over twenty years. She has published articles in Ceramics Monthly Magazine and Ceramics: Art &amp; Perception. Her work, featured on the cover of the book, Electric Firing: Creative Techniques”, included her article on cone 6 glazes. She wrote a guidebook on teaching ceramics and designing ceramic studios. Recently Jayne has been</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="16" font-family="Times New Roman">creating sculpture on War and Hunger and has her work in the Pendemics Journal, Spring issue 2024 and Poetry X Hunger website.</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="16" font-family="Times New Roman">Ceramic history research has been a significant interest for Jayne for over forty years. She produced an historical Slide Library through the NY State Council on the Arts, of over one thousand images. Her lectures can be seen at www.jayneshatzpottery.com, entitled, “Moments in Ceramic History”. Jayne lectures in colleges, art centers and conferences and was a returning lecturer of Ceramic History at Hood College, MD for several years. In 2016, Union College, NY, installed a permanent exhibit of her sculpture constructed from</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="16" font-family="Times New Roman">10,000 year old clay excavated at the college. She has also exhibited in numerous galleries, including the Maryland Federation of Art; Chesapeake Art Center; West Annapolis ArtWorks; St. John’s College, MD; Anne Marie Sculpture Garden, MD, The Artist Gallery, Ellicott City, MD, The Artist Gallery, Alexandria, VA;The Farmington Valley Arts Center, CT; Lynn Kottler’s Gallery, NYC; Luther Brady Art Gallery, Corcoran DC; Art Show International Art Competition, CA, Honorable Mention; Krasdale Foods, Corporate Headquarters, NY; Brookfield Craft Center, CT; Peter’s Valley Arts Center, NJ; Rome Art Center, NY and The Hyde Collection, NY; The American Craft Enterprise, NY; Frederick Craft Fair, MD and the Pacific Design Center, CA. Jayne has received several awards. She was awarded the Studio Potter Foundation’s National Award for Excellence in Ceramic Education and was an Artist In Residence with the NY Foundation For The Arts. She directed a project through the NY State Museum in Albany and the United States Holocaust Museum in Washington, DC with children’s tiles depicting the Holocaust, tiles installed at the Holocaust Museum in Washington DC in the permanent exhibit "Remember the Children-Wall of Remembrance”. She also received awards in Sculpture, First Prize and Best in Show in galleries in DC and MD. Jayne’s studio is near Annapolis Maryland.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Form resizeable="no" height="auto" width="100%" y="" x=""/></Element><HeadTag><![CDATA[
    
