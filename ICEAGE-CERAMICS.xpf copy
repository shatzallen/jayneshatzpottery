t></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-68" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="7004" bgcolor="" x="653" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element53" groupID="14"><Paragraph align="center"><Segment color="#C7BDAE" font-size="12" font-family="Helvetica">Xianrendong Cave, China, 20,000 year old cookware</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-69" templateID="" height="20" editable="true" type="Text" border-width="0" padding="0" y="6997" bgcolor="" x="1089" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element55" groupID="15"><Paragraph><Segment color="#C7BDAE" font-size="12" font-family="Helvetica">Xianrendong Cave, China, archeologists</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-70" templateID="" height="32" editable="true" type="Text" border-width="0" padding="0" y="4894" bgcolor="" x="419" sizePositionLocked="false" width="783" locked="" deletable="" uniqueID="element56"><Paragraph><Segment color="#FDEDC0" font-size="22" font-family="Helvetica">New archeological excavation discoveries, documented 2012</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element link="JSPARTICLES.html" width="59" WOHratio="0.5" y="7205" type="ImportedImage" x="817" alt="" deletable="" editable="true" originalSource="" name="Add an Image-86" sizePositionLocked="false" height="118" templateID="" locked="" fileType="IMAGEFILTER" link_target="_self" uniqueID="element58" isImageType="true" resizeable="true" maintainProportion="true" src="new_logo.jpg" bucketRatio="0.5" imageRatio="0.5" offsetX="0" offsetY="0" zoom="1" editMode="normalMode" origWidth="137" origHeight="274" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" groupID="20"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-71" templateID="" height="63" editable="true" type="Text" border-width="0" padding="0" y="7128" bgcolor="" x="114" sizePositionLocked="false" width="1352" locked="" deletable="" uniqueID="element57"><Paragraph><Segment color="#C7BDAE" font-size="14" font-family="Helvetica">What I am beginning to comprehend, is that the field of archeology is fluid and continually changing. With new excavations, we learn more about our ancestors, and therefore, more about ourselves. No matter how far back in time we travel, I still believe that the ceramic artisans of thousands of years ago had the same drive, yearnig and need to create pottery and sculpture as I do today!</Segment><Segment color="#000000" font-size="10" font-family="Helvetica">xtW. W</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-13" templateID="" alt="" height="79" editable="true" maintainProportion="true" link_target="_blank" type="ImportedImage" isImageType="true" y="7232" x="1201" src="throwing.jpeg" sizePositionLocked="false" resizeable="true" link="http://ceramicartsdaily.org/ceramics-monthly/" width="107" locked="" deletable="" WOHratio="1.3603603603603605" fileType="IMAGEFILTER" uniqueID="element59" originalSource="" bucketRatio="1.3603603603603605" imageRatio="1.3603603603603605" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="604" origHeight="444" imageWidth="604" imageHeight="444"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-73" templateID="" height="23