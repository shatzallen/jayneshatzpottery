 dialogButton="" type="ImageEffect" filter="FlashImageFilter" fileType="FLASHIMAGEFILTER" origWidth="100" origHeight="100"/><?property ignore-whitespace="false"?><Element groupID="15" name="Text-39" height="30" bgcolor="" deletable="" type="Text" border-color="#000000" y="7443" uniqueID="element77" x="587" templateID="" padding="0" locked="" width="215" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#FFFFFF">MARY CHASE PERRY, PEWABIC POTTERY, DETROIT, MI, 1929</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element name="Text-40" height="45" bgcolor="" deletable="" type="Text" border-color="#000000" y="7409" uniqueID="element78" x="172" templateID="" padding="0" locked="" width="255" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#FFFFFF" font-size="10" font-family="Helvetica">ADELAIDE ALSOP ROBINEAU, </Segment></Paragraph><Paragraph><Segment color="#FFFFFF" font-size="10" font-family="Helvetica">SCARAB VASE, SYRACUSE, NY, 1910</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element groupID="18" name="Text-41" height="20" bgcolor="" deletable="" type="Text" border-color="#000000" y="6620" uniqueID="element79" x="565" templateID="" padding="0" locked="" width="264" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#FFFFFF">MARIA MARTINEZ, SAN ILDEFONSO, NM</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element name="Text-42" height="32" bgcolor="" deletable="" type="Text" border-color="#000000" y="6923" uniqueID="element80" x="197" templateID="" padding="0" locked="" width="221" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#FFFFFF" font-size="10" font-family="Helvetica">MARTINEZ, SAN ILDEFONSO, NM, </Segment></Paragraph><Paragraph><Segment color="#FFFFFF" font-size="10" font-family="Helvetica">BLACK ON BLACK, 1935</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element groupID="19" name="Text-43" height="20" bgcolor="" deletable="" type="Text" border-color="#000000" y="7821" uniqueID="element81" x="219" templateID="" padding="0" locked="" width="222" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#FFFFFF">GERTRUDE AND OTTO NATZLER</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element link="" width="189" WOHratio="0.6615384615384615" type="ImportedImage" y="7572" alt="" x="595" originalSource="" editable="true" deletable="" locked="" templateID="" height="286" sizePositionLocked="false" name="Image-22" link_target="_self" fileType="IMAGEFILTER" resizeable="true" isImageType="true" uniqueID="element82" src="NATZLER_FOOTED_BOWL__1957.jpg" maintainProportion="true" bucketRatio="0.6615384615384615" imageRatio="0.6615384615384615" offsetX="0" offsetY="0" zoom="1" editMode="normalMode" origWidth="258" origHeight="390" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element name="Text-44" height="30" bgcolor="" deletable="" type="Text" border-color="#000000" y="7865" uniqueID="element83" x="583" templateID="" padding="0" locked="" width="215" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#FFFFFF" font-size="10" font-family="Helvetica">NATZLERS FOOTED BOWL, 1935</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element groupID="21" name="Text-45" height="15" bgcolor="" deletable="" type="Text" border-color="#000000" y="8203" uniqueID="element84" x="224" templateID="" padding="0" locked="" width="189" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#FFFFFF">FRAN SIMCHES CHEST, 1972</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element groupID="44" name="Text-46" height="30" bgcolor="" deletable="" type="Text" border-color="#000000" y="8229" uniqueID="element85" x="662" templateID="" padding="0" locked="" width="142" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#FFFFFF" font-size="10" font-family="Helvetica">SIMCHES, BOX 1971</Segment><Segment color="#000000" font-size="10" font-family="Helvetica"> </Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element groupID="24" name="Text-47" height="20" bgcolor="" deletable="" type="Text" border-color="#000000" y="8595" uniqueID="element86" x="271" templateID="" padding="0" locked="" width="144" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#FFFFFF">IRA MESSING 1975</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element groupID="23" name="Text-48" height="20" bgcolor="" deletable="" type="Text" border-color="#000000" y="8583" uniqueID="element87" x="607" templateID="" padding="0" locked="" width="173" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#FFFFFF">IRA MESSING, SINK, 1983</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element link="" width="190" WOHratio="0.6266666666666667" type="ImportedImage" y="1037" alt="" x="663" originalSource="" editable="true" deletable="" locked="" templateID="" height="303" sizePositionLocked="false" name="Image-24" link_target="_self" fileType="IMAGEFILTER" groupID="25" resizeable="true" isImageType="true" uniqueID="element89" src="DOLNI_VESTONICE_Venus_6-9_h_kiln_fired_clay_27_000BPE.jpg" maintainProportion="true" bucketRatio="0.6266666666666667" imageRatio="0.6266666666666667" offsetX="0" offsetY="0" zoom="1" editMode="normalMode" origWidth="376" origHeight="600" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element deletable="" name="Text-49" height="168" border-color="#000000" y="1223" x="36" border-width="0" bgcolor="" editable="true" templateID="" type="Text" locked="" width="538" padding="0" sizePositionLocked="false" uniqueID="element90"><Paragraph><Segment color="#E8E7CE" font-size="12" font-family="Helvetica" font-style="bold">The Paleolithic travelers did not keep clay storage vessels, as they were heavy and too fragile for constant traveling. However, they were versatile with the ceramic medium and they knew how to fire kilns. Clay was modeled and fired as early as 27,000 BC for the production of ceremonial fertility objects, the venus figurines. These sculptures were fired in small simple clay kilns found in the huts of special individuals, presumably the shamens of the clans. (Refer to my article “Ice Age Ceramics,” Ceramics Monthly, February, 1992, pp.78-79). </Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element groupID="25" name="Text-50" height="30" bgcolor="" deletable="" type="Text" border-color="#000000" y="1349" uniqueID="element91" x="635" templateID="" padding="0" locked="" width="249" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#FFFFFF">DOLNI VESTONICE, VENUS FIGURINE</Segment></Paragraph><Paragraph><Segment color="#FFFFFF">        27,000 BPE, 9 " h</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element deletable="" height="232" name="Image Effect-4" maintainProportion="true" templateID="" sizePositionLocked="false" WOHratio="1.1527377521613833" width="267" effectStyle_Display="Sliding flicker" uniqueID="element98" y="2956" originalSource="" editable="true" locked="" x="348" src="Lascaux__Dordogne__Bisons15_000_BPE.jpg" groupID="27" resizeable="true" effectStyle="fadeIn" effectColor="#999999" dialogButton="" type="ImageEffect" filter="FlashImageFilter" fileType="FLASHIMAGEFILTER" origWidth="100" origHeight="100"/><?property ignore-whitespace="false"?><Element deletable="" name="Text-51" height="168" border-color="#000000" y="3257" x="31" border-width="0" bgcolor="" editable="true" templateID="" type="Text" locked="" width="914" padding="0" sizePositionLocked="false" uniqueID="element99"><Paragraph><Segment color="#E8E7CE" font-size="12" font-family="Helvetica" font-style="bold">Early primitive potters were knowledgeable of the alteration of clay color from the effects of fire.  They learned that clay fired at high temperatures with a supply of oxygen produced a red surface; when the oxygen was reduced, the result was black. They produced a black ware by covering the pot with chaff or other organic vegetable matter. Local clays react differently and the difficulty of forecasting surface color must have been one of the most frustrating aspects of pottery production for the early potters. Sound familiar? They fired their pottery in beehive shaped ovens that they also used for cooking. Oftentimes, they placed the pottery in an open hearth covered with brushwood, with temperatures climbing to about 800 degrees F. As the crafts of pottery and kiln building continued to develop, pottery became one of the most important treasures of the Neolithic people.</Segment></Paragraph><Paragraph><Segment color="#E8E7CE" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element groupID="27" name="Text-52" height="15" bgcolor="" deletable="" type="Text" border-color="#000000" y="3197" uniqueID="element100" x="345" templateID="" padding="0" locked="" width="300" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#FFFFFF">LASCAUX, DORDOGNE, BISONS, 15,000 BPE</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element link="index.html" width="76" WOHratio="0.5" type="ImportedImage" y="26964" alt="" x="209" originalSource="" editable="true" deletable="" locked="" templateID="" height="152" sizePositionLocked="false" name="Add an Image-84" link_target="_self" fileType="IMAGEFILTER" groupID="28" resizeable="true" isImageType="true" uniqueID="element101" src="new_logo.jpg" maintainProportion="true" bucketRatio="0.5" imageRatio="0.5" offsetX="0" offsetY="0" zoom="1" editMode="normalMode" origWidth="137" origHeight="274" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element groupID="28" name="Text-53" height="30" bgcolor="" deletable="" type="Text" border-color="#000000" y="27025" uniqueID="element102" x="231" templateID="" padding="0" locked="" width="167" border-width="0" editable="true" sizePositionLocked="false"><Paragraph><Segment color="#28F9EA" font-family="Times New Roman" font-style="bold" link_target="_self" href="index.html" font-size="20">HOME PAGE</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element link="index.html" width="59" WOHratio="0.5" y="9031" type="ImportedImage" x="270" alt="" deletable="" editable="true" originalSource="" name="Add an Image-85" sizePositionLocked="false" height="118" templateID="" locked="" fileType="IMAGEFILTER" link_target="_self" groupID="45" uniqueID="element106" isImageType="true" resizeable="true" maintainProportion="true" src="new_logo.jpg" bucketRatio="0.5" imageRatio="0.5" offsetX="0" offsetY="0" zoom="1" editMode="normalMode" origWidth="137" origHeight="274" 