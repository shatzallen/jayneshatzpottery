Y="0" zoom="1" editMode="normalMode" origWidth="800" origHeight="266" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-2" templateID="" height="203" editable="true" type="Text" border-width="0" padding="0" y="608" bgcolor="" x="154" sizePositionLocked="false" width="886" locked="" deletable="" uniqueID="element4"><Paragraph><Segment color="#CC9966" font-size="20" font-family="Times New Roman">I will be exhibiting with some members of the Potters Guild of Annapolis in a beautiful exhibit entitled "The Splendid Table". We will have items set on a dining room table that will surely enhance your dining experience-ready for your holiday celebrations! I hope to see you at the opening reception in the lovely West Annapolis Art Works Gallery, 4 Annapolis ST., Annapolis, MD, 21401, 410-295-7045, artworkswest@gmail.com. Information is on the card and I have included images of some of the items I will have for sale. Hope to see you there, Jayne</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element bucketRatio="0.5" alt="" deletable="" offsetX="0" WOHratio="0.5" type="ImportedImage" groupID="2" sizePositionLocked="false" name="Add an Image-38" height="156" editable="true" zoom="1" offsetY="0" fileType="IMAGEFILTER" maintainProportion="true" uniqueID="element6" width="78" link_target="_self" templateID="" locked="" isImageType="true" src="new_logo.jpg" imageRatio="0.5" link="index.html" y="625" x="1169" originalSource="" onPublish="ImportedImage" onPreview="ImportedImage" resizeable="true" editMode="normalMode" origWidth="137" origHeight="274" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignor