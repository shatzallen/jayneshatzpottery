NG_COPPER_PATINA.jpeg" sizePositionLocked="false" resizeable="true" link="" width="563" locked="" deletable="" WOHratio="1.3333333333333333" fileType="IMAGEFILTER" uniqueID="element22" originalSource="" bucketRatio="1.3333333333333333" imageRatio="1.3333333333333333" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="600" imageWidth="800" imageHeight="600" groupID="8"/><Element name="Image-11" templateID="" alt="" height="401" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="4120" x="1182" src="APPLYING_CYAN_PATINA.jpeg" sizePositionLocked="false" resizeable="true" link="" width="535" locked="" deletable="" WOHratio="1.3333333333333333" fileType="IMAGEFILTER" uniqueID="element23" originalSource="" bucketRatio="1.3333333333333333" imageRatio="1.3333333333333333" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="600" imageWidth="800" imageHeight="600" groupID="9"/><Element name="Image-12" templateID="" alt="" height="373" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="4841" x="82" src="PAINTING_WHITE_BASE.jpg" sizePositionLocked="false" resizeable="true" link="" width="455" locked="" deletable="" WOHratio="1.2195121951219512" fileType="IMAGEFILTER" uniqueID="element24" originalSource="" bucketRatio="1.2195121951219512" imageRatio="1.2195121951219512" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="656" imageWidth="800" imageHeight="656" groupID="14"/><Element name="Image-13" templateID="" alt="" height="371" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="4850" x="674" src="PINK_PATINA.jpg" sizePositionLocked="false" resizeable="true" link="" width="462" locked="" deletable="" WOHratio="1.244167962674961" fileType="IMAGEFILTER" uniqueID="element25" originalSource="" bucketRatio="1.244167962674961" imageRatio="1.244167962674961" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="643" imageWidth="800" imageHeight="643" groupID="18"/><Element name="Image-14" templateID="" alt="" height="382" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="4853" x="1232" src="PINK_AND_BLUE_PATINAS_ON_PORCELAIN.jpg" sizePositionLocked="false" resizeable="true" link="" width="455" locked="" deletable="" WOHratio="1.1922503725782414" fileType="IMAGEFILTER" uniqueID="element27" originalSource="" bucketRatio="1.1922503725782414" imageRatio="1.1922503725782414" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="800" origHeight="671" imageWidth="800" imageHeight="671" groupID="17"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-8" templateID="" height="49" editable="true" type="Text" border-width="0" padding="0" y="1895" bgcolor="" x="82" sizePositionLocked="false" width="791" locked="" deletable="" uniqueID="element29" groupID="1"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">1. Black Based Patinas</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">The colored pieces begin with a black base, and then colored patinas are used over. I don't use a strong black, rather, I tone it down with some white to yield a charcoal grey. This is a great base for patinas.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-9" templateID="" height="45" editable="true" type="Text" border-width="0" padding="0" y="2475" bgcolor="" x="1140" sizePositionLocked="false" width="412" locked="" deletable="" uniqueID="element30" groupID="2"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">2. Painting Base Coat</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">I apply the charcoal grey mixture with a soft brush, covering the entire piece. I use latex gloves to make clean up easy.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-10" templateID="" height="60" editable="true" type="Text" border-width="0" padding="0" y="3333" bgcolor="" x="368" sizePositionLocked="false" width="391" locked="" deletable="" uniqueID="element31" groupID="15"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">3. Gold Metallic Patinas</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">These metallic patinas can be purchased in tubes and bottles, I use both. The tubes are better for the rubbed patinas, I use the cheaper thinner, bottled acrylics for the base coats.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-11" templateID="" height="76" editable="true" type="Text" border-width="0" padding="0" y="3175" bgcolor="" x="1165" sizePositionLocked="false" width="389" locked="" deletable="" uniqueID="element32" groupID="11"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">4. Paper Towel Application</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">I lay down acrylic on the newspaper, and begin using a paper towel for the applier. I can add different colors and mix them on the newspaper, then apply to the form. </Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"/></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-16" templateID="" alt="" height="458" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="3463" x="1275" src="CYAN_METALLIC_OVER_GOLD_2_.jpeg" sizePositionLocked="false" resizeable="true" link="" width="344" locked="" deletable="" WOHratio="0.75" fileType="IMAGEFILTER" uniqueID="element33" originalSource="" bucketRatio="0.75" imageRatio="0.75" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="432" origHeight="576" imageWidth="432" imageHeight="576" groupID="6"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-12" templateID="" height="96" editable="true" type="Text" border-width="0" padding="0" y="3924" bgcolor="" x="210" sizePositionLocked="false" width="333" locked="" deletable="" uniqueID="element34" groupID="4"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">5.Gold Patina Applied to Base</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">I apply the acrylic with the towel, freely rubbing it onto the form. I rub quickly, letting the paint play with the surface of the pot. I let some of the base, black in this case, to seep through, providing an uneven appearance. </Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-13" templateID="" height="45" editable="true" type="Text" border-width="0" padding="0" y="3918" bgcolor="" x="774" sizePositionLocked="false" width="327" locked="" deletable="" uniqueID="element35" groupID="5"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">6. Gold Patina Over the Black Base</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">I apply the gold over the entire piece, moving quickly in straight lines and circles, developing a differentiation of color.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-14" templateID="" height="128" editable="true" type="Text" border-width="0" padding="0" y="3927" bgcolor="" x="1282" sizePositionLocked="false" width="335" locked="" deletable="" uniqueID="element36" groupID="6"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">7. Cyan Metallic Over Gold</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">I apply various paints to develop my color combinations. After the gold patina I use a metallic blue, which then creates a mottled green patina. Try many colors, applying them both to a dry base or a newly applied damp base. Each application will provide a different effect. This is where creativity, surprise and fun builds.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-17" templateID="" alt="" height="576" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="4116" x="64" src="GOLD_PAINT_BASE2.jpeg" sizePositionLocked="false" resizeable="true" link="" width="432" locked="" deletable="" WOHratio="0.75" fileType="IMAGEFILTER" uniqueID="element38" originalSource="" bucketRatio="0.75" imageRatio="0.75" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="432" origHeight="576" imageWidth="432" imageHeight="576" groupID="7"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-15" templateID="" height="86" editable="true" type="Text" border-width="0" padding="0" y="4699" bgcolor="" x="67" sizePositionLocked="false" width="432" locked="" deletable="" uniqueID="element39" groupID="7"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">8. Gold Paint Base</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">Another combination is beginning with a gold base. I then cover the piece with copper  and cyan acrylics. For the base, I use a thin paint, as shown with Loft Flow Acrylic. When painting the base, use a thinner less expensive paint than the tubes which I use for patina effects.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-16" templateID="" height="64" editable="true" type="Text" border-width="0" padding="0" y="4550" bgcolor="" x="557" sizePositionLocked="false" width="553" locked="" deletable="" uniqueID="element40" groupID="8"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">9. Applying Copper Patina</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">Begin applying the next color over the gold base. I like to use copper along with gold to achieve a rich warm color. </Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-17" templateID="" height="64" editable="true" type="Text" border-width="0" padding="0" y="4528" bgcolor="" x="1184" sizePositionLocked="false" width="524" locked="" deletable="" uniqueID="element41" groupID="9"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">10. Applying the Cyan Patina</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">I then apply a cyan mixed with paint to provide coloration in shadow areas. Again,  paint over both dry and damp surfaces, providing variety of color. </Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-18" templateID="" height="31" editable="true" type="Text" border-width="0" padding="0" y="5222" bgcolor="" x="84" sizePositionLocked="false" width="446" locked="" deletable="" uniqueID="element42" groupID="14"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">11. Painting White Base</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">I apply an iridescent white acrylic as the base coat.</Segment><Segment color="#000000" font-size="10" font-family="Helvetica"> </Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-19" templateID="" height="30" editable="true" type="Text" border-width="0" padding="0" y="5225" bgcolor="" x="673" sizePositionLocked="false" width="457" locked="" deletable="" uniqueID="element43" groupID="18"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">12. Pink Patina on White Base</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">I add pink paint on top of white paint.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-20" templateID="" height="30" editable="true" type="Text" border-width="0" padding="0" y="5241" bgcolor="" x="1236" sizePositionLocked="false" width="444" locked="" deletable="" uniqueID="element44" groupID="17"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="italic">13. Pink and Blue Patinas on Porcelain</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">Apply blue paint and rub into pink and white paints</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-21" templateID="" height="90" editable="true" type="Text" border-width="0" padding="0" y="4645" bgcolor="" x="785" sizePositionLocked="false" width="741" locked="" deletable="" uniqueID="element45"><Paragraph><Segment color="#000000" font-size="20" font-family="Times New Roman" font-style="bold">I met Voulkos one summer in Saratoga, NY, remembering him saying that if you weren't going to use the piece for eating, why bother dealing with glazes? That was a turning point for me.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-22" templateID="" height="180" editable="true" type="Text" border-width="0" padding="0" y="5326" bgcolor="" x="325" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element46"><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman" font-style="bold">About the Author</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman">Jayne Shatz, artist, educator and ceramic historian, has a PhD in Prehistoric Ceramics, an MA in Pottery and Sculpture and a BA in Art History. A ceramic career spanning over 47 years, she has directed college programs in New York, founded two potters' cooperatives and exhibits her pottery and sculpture. She has been writing for many years, publishing articles on ceramic  history and techniques and has been  producing educational ceramic videos, distributing them through her website. </Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Times New Roman"/></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-23" templateID="" height="137" editable="true" type="Text" border-width="0" padding="0" y="5348" bgcolor="" x="987" sizePositionLocked="false" width="395" locked="" deletable="" uniqueID="element47"><Paragraph align="center"><Segment color="#000000" font-size="12" font-family="Times New Roman">This article is printed with the permission of </Segment></Paragraph><Paragraph><Segment color="#000000" font-size="18" font-family="Times New Roman">Ceramic Arts &amp; Perception/Technical</Segment></Paragraph><Paragraph align="center"><Segment color="#000000" font-size="14" font-family="Times New Roman">Published #117, 2021</Segment></Paragraph><Paragraph align="center"><Segment color="#000000" font-size="14" font-family="Times New Roman"/></Paragraph><Paragraph align="center"><Segment color="#000000" font-size="14" font-family="Helvetica">http://www.mansfieldceramics.com/</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-18" templateID="" alt="" height="170" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="5516" x="827" src="new_logo.jpg" sizePositionLocked="false" resizeable="true" link="index.html" width="85" locked="" deletable="