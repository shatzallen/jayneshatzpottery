<Page lastUpdated="Fri Oct 27 11:06:07 EDT 2006" lastPublish="1161961743598" localPreview="true" lastMod="1161961564911" showingTemplate="false" lastSave="1161961567489" groupID="39" dirty=""><Element filename="JAPANESEFOLKPOTTERY" backgroundType="bgColor" uniqueID="element1" changed="@bgColor,@changed,@width,@uidCounter,@pageURI,@filename,@title," passwordProtectedFile="" pageURI="http://jayneshatzpottery1.homestead.com/JAPANESEFOLKPOTTERY.html" type="Page" keyword="Japanese pottery&#10;japanese ceramics&#10;Jomon,&#10;Sue,&#10;Tamba,&#10;Seto,&#10;Bizen,&#10;Karatsu,&#10;Iga,&#10;Oribe,&#10;Shino,&#10;Kenzan,&#10;Nabeshima,&#10;Shoji Hamada,&#10;Tatsuzo shimoaka,&#10;Shiro tsujimura,&#10;Tomimoto,&#10;Katari shirayamadani,&#10;" center="false" pagePassword="" description="historical overview of japanese pottery from ancient jomon period to the 20th century, Jomon Pottery, Japanese pottery, ancient pottery, Japan clay" bgPattern="ibog:/Backgrounds#algae.gif" bgImage="" copyrightBy="" currentWindow="1" followedLinkColor="#6633CC" width="1500" linkColor="#3333CC" bgColor="#999999" copyrightFooterStyle="Select A Style" addCopyright="true" imageToolbarOff="false" uidCounter="76" onPublish="PageElement" title="JAPANESEFOLKPOTTERY" footerTextColor="#000000" footerTextSize="12" showFooter="true" footerBackgroundColor="#FFFFFF" quicksiteDesign="true" onload="" editable="true" onunload="" master="" footerTextFont="Arial" footerBorderColor="#FFFFFF" footerLinkColor="#406AB0" footerHasBackground="true" headTag=""><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="22" name="Text-1" x="62" templateID="" width="802" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="55" uniqueID="element2"><Paragraph><Segment color="#000000" font-size="36" font-family="Times New Roman" font-style="bold">          JAYNE SHATZ POTTERY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="85" name="Text-3" x="356" templateID="" width="243" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="69" uniqueID="element4"><Paragraph><Segment color="#000000" font-size="16" font-family="Times New Roman" font-style="bold">PhD-Prehistoric Ceramics</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="16" font-family="Times New Roman" font-style="bold">MA- Pottery and Sculpture</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="16" font-family="Times New Roman" font-style="bold">BA - Art History</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="189" name="Text-4" x="208" templateID="" width="671" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="30" uniqueID="element5"><Paragraph><Segment color="#000000" font-size="20" font-family="Times New Roman" font-style="bold">     THE RICH HERITAGE OF JAPANESE POTTERY</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="261" name="Text-5" x="51" templateID="" width="901" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="171" uniqueID="element6"><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold">Traditional Japanese folk pottery epitomizes work produced with the ease of unconscious thought; it is work that is created without judgment and exemplifies pure artistic energy. Initially, Japanese pottery was produced to hold liquids or grains and to be eaten out of, each form surrendering to caressing hands. The sensation of touch became as important to the potter as that of the visual. </Segment></Paragraph><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold"/></Paragraph><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold">Ancient Japanese pottery dates back over twelve thousand years to the wondrous ceramics of the Jomon era; it was here that the first coiled pots emerged. Notice the frenetic decorative coils and waving soaring rims that exemplify  this beautiful ancient ware. This Jomon ware of yesteryear is as impetuous and alive as today’s most contemporary work. </Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-2" link_target="_self" maintainProportion="true" originalSource="" src="Jomon_2000-1000_bc.jpg" height="299" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="30" width="226" WOHratio="0.7569444444444444" y="469" link="" x="79" uniqueID="element7" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.7569444444444444" imageRatio="0.7569444444444444" editMode="normalMode" origWidth="226" origHeight="299" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element8" deletable="" border-width="0" y="753" x="82" width="177" editable="true" name="Text-6" height="16" padding="0" groupID="30" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Jomon 12,500-1,500 bc</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-3" link_target="_self" maintainProportion="true" originalSource="" src="Jomon_2000_bc.jpg" height="303" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="31" width="243" WOHratio="0.8009259259259259" y="467" link="" x="391" uniqueID="element9" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.8009259259259259" imageRatio="0.8009259259259259" editMode="normalMode" origWidth="217" origHeight="270" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element10" deletable="" border-width="0" y="752" x="391" width="246" editable="true" name="Text-7" height="16" padding="0" groupID="31" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Jomon Storage Vessel 12,500-1,500 bc</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-4" link_target="_self" maintainProportion="true" originalSource="" src="Yayoi_Neolithic.jpg" height="296" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="3" width="215" WOHratio="0.7245370370370371" y="471" link="" x="706" uniqueID="element11" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.7245370370370371" imageRatio="0.7245370370370371" editMode="normalMode" origWidth="214" origHeight="295" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element12" deletable="" border-width="0" y="750" x="717" width="199" editable="true" name="Text-8" height="16" padding="0" groupID="3" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Neolithic Yayoi     2000-1000bc</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="806" name="Text-11" x="72" templateID="" width="916" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="206" uniqueID="element15"><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold">Pottery made during the Yayoi period began displaying colored engobes and a more painterly style. These Neolithic farmers made pottery to be used for storage, yet the desire to decorate was of great importance to these ancient craftsmen.</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold"/></Paragraph><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold"/></Paragraph><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold">As we move towards the 5th and 6th centuries, we see a simple feldspathic glaze being employed on the Sue period pottery. This beautiful glossy gray-green surface was the beginnings of Japanese celedons. As this glossy, clean surfaced ware was developing, the rugged Bizen and Tamba ware were being produced into the 1300's. Thick, bubbly glazes laden with ash, unglazed feet and uneven rims exemplify the beauty and total freedom of Bizen ware.  With their irregularity and asymmetry, these sumptuous  forms exhibit the essence of the Japanese concepts of beau</Segment><Segment color="#FDEDC0" font-size="12" font-family="Helvetica" font-style="bold">ty.</Segment></Paragraph><Paragraph><Segment color="#FDEDC0" font-size="10" font-family="Helvetica"></Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-5" link_target="_self" maintainProportion="true" originalSource="" src="Sue_5-6th_c.jpg" height="276" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="4" width="188" WOHratio="0.6828703703703703" y="1054" link="" x="49" uniqueID="element16" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.6828703703703703" imageRatio="0.6828703703703703" editMode="normalMode" origWidth="188" origHeight="276" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element17" deletable="" border-width="0" y="1314" x="49" width="111" editable="true" name="Text-12" height="20" padding="0" groupID="4" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Sue 5th-6th C ad</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-6" link_target="_self" maintainProportion="true" originalSource="" src="Bizen_12-13th_c.jpg" height="271" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="5" width="185" WOHratio="0.6828703703703703" y="1054" link="" x="291" uniqueID="element18" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.6828703703703703" imageRatio="0.6828703703703703" editMode="normalMode" origWidth="185" origHeight="271" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element19" deletable="" border-width="0" y="1310" x="292" width="196" editable="true" name="Text-13" height="20" padding="0" groupID="5" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Bizen                  1200-1300ad</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-7" link_target="_self" maintainProportion="true" originalSource="" src="Seto_12-13th_c.jpg" height="202" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="6" width="229" WOHratio="1.1322033898305084" y="1083" link="" x="502" uniqueID="element20" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="1.1322033898305084" imageRatio="1.1322033898305084" editMode="normalMode" origWidth="229" origHeight="202" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element21" deletable="" border-width="0" y="1270" x="502" width="242" editable="true" name="Text-14" height="16" padding="0" groupID="6" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Seto                               1200-1300ad</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-8" link_target="_self" maintainProportion="true" originalSource="" src="Tamba_storage_jar_Kama_Kura_per.c_1200.jpg" height="274" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="7" width="187" WOHratio="0.6828703703703703" y="1052" link="" x="757" uniqueID="element22" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.6828703703703703" imageRatio="0.6828703703703703" editMode="normalMode" origWidth="187" origHeight="274" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element23" deletable="" border-width="0" y="1308" x="761" width="176" editable="true" name="Text-15" height="20" padding="0" groupID="7" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Tamba, Kamakura, 1200 ad </Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="1377" name="Text-16" x="45" templateID="" width="903" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="111" uniqueID="element24"><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold">Tea bowls are synonymous with Japanese pottery. These humble forms were originally made in great quantities, providing functional ware for Japan's great pastime-drinking tea . Each piece, though mass produced was a symbol of a particular potter's body of work. In some Japanese workshops, an apprentice might make 500 tea bowls, pick one, and then destroy all the others. That one tea bowl would be the essence of that potter's work, and the apprentice would discover his style.</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"></Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-9" link_target="_self" maintainProportion="true" originalSource="" src="Seto__12-13th_c.jpg" height="209" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="8" width="306" WOHratio="1.464406779661017" y="1506" link="" x="138" uniqueID="element25" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="1.464406779661017" imageRatio="1.464406779661017" editMode="normalMode" origWidth="254" origHeight="174" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element26" deletable="" border-width="0" y="1694" x="150" width="293" editable="true" name="Text-17" height="16" padding="0" groupID="8" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Seto                                             1200-1300 ad</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-10" link_target="_self" maintainProportion="true" originalSource="" src="Karatsu_16-17th_c.jpg" height="212" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="9" width="261" WOHratio="1.2272727272727273" y="1496" link="" x="551" uniqueID="element27" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="1.2272727272727273" imageRatio="1.2272727272727273" editMode="normalMode" origWidth="261" origHeight="212" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element28" deletable="" border-width="0" y="1692" x="553" width="286" editable="true" name="Text-18" height="20" padding="0" groupID="9" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Karatsu                                1600-1700 ad</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="1758" name="Text-19" x="55" templateID="" width="899" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="114" uniqueID="element29"><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold">As you look upon the tea bowls in this presentation, think how your hands would lovingly fondle each piece, and how your eyes might linger on the inside of each bowl, gazing at the pattern made by tea leaves. This is the core of Japanese folk pottery. The concept of the “Unknown Craftsman” originated from the every day humble ware produced by all the unknown potters working in the unconscious spirit of the collective soul. This philosophy was passed down by generations of potters resulting in a spontaneous interaction with clay and a total command of the materials. Having no need for identity, much of this ware remained unsigned.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-11" link_target="_self" maintainProportion="true" originalSource="" src="Iga_c_1585-1700_.jpg" height="263" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="29" width="159" WOHratio="0.6064814814814815" y="1918" link="" x="121" uniqueID="element30" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.6064814814814815" imageRatio="0.6064814814814815" editMode="normalMode" origWidth="164" origHeight="271" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element31" deletable="" border-width="0" y="2100" x="124" width="51" editable="true" name="Text-20" height="80" padding="0" groupID="29" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold"> Iga       </Segment></Paragraph><Paragraph><Segment font-style="bold">   </Segment></Paragraph><Paragraph><Segment font-style="bold">         1585-1700 ad</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-12" link_target="_self" maintainProportion="true" originalSource="" src="Oribe_16th_c.jpg" height="202" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="11" width="284" WOHratio="1.4071661237785016" y="1938" link="" x="340" uniqueID="element32" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="1.4071661237785016" imageRatio="1.4071661237785016" editMode="normalMode" origWidth="284" origHeight="202" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element33" deletable="" border-width="0" y="2123" x="345" width="300" editable="true" name="Text-21" height="20" padding="0" groupID="11" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Oribe Food Box                             16th C ad</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-13" link_target="_self" maintainProportion="true" originalSource="" src="Shino_16th_c.jpg" height="243" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="12" width="261" WOHratio="1.0719602977667493" y="1917" link="" x="665" uniqueID="element34" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="1.0719602977667493" imageRatio="1.0719602977667493" editMode="normalMode" origWidth="261" origHeight="243" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element35" deletable="" border-width="0" y="2141" x="666" width="279" editable="true" name="Text-22" height="20" padding="0" groupID="12" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Shino                                         16th C ad</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="2237" name="Text-23" x="83" templateID="" width="883" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="111" uniqueID="element36"><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold">Iga, Oribe and Shino ware maintained the traditional characteristics of Japanese folk pottery, with their uneven rims and thick, spontaneously flowing glazes.  As in the example of Oribe, Oribe was a family name, not an actual period. However, pottery evolved as the livelihood of not just one family, but its many generations that were to follow. We begin to see pottery designated by  family names, such as Oribe and Kenzan, and the practice of the Unknown Craftsmen diminished.</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"></Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-14" link_target="_self" maintainProportion="true" originalSource="" src="Kenzan_1664-1743.jpg" height="265" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="13" width="181" WOHratio="0.6828703703703703" y="2386" link="" x="209" uniqueID="element37" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.6828703703703703" imageRatio="0.6828703703703703" editMode="normalMode" origWidth="181" origHeight="265" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element38" deletable="" border-width="0" y="2634" x="212" width="188" editable="true" name="Text-24" height="20" padding="0" groupID="13" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Kenzan                 1664-1743</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-15" link_target="_self" maintainProportion="true" originalSource="" src="Oribe_incense_burner_16th_c.jpg" height="254" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="14" width="316" WOHratio="1.2485549132947977" y="2390" link="" x="518" uniqueID="element39" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="1.2485549132947977" imageRatio="1.2485549132947977" editMode="normalMode" origWidth="316" origHeight="254" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element40" deletable="" border-width="0" y="2628" x="526" width="300" editable="true" name="Text-25" height="20" padding="0" groupID="14" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Oribe Incense Burner 16th C ad</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="2715" name="Text-26" x="72" templateID="" width="872" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="133" uniqueID="element41"><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold">As pottery evolved into more decorative containers, the paintings on the ware became more structured, and the Japanese claimed a vigorous retail market. During the 17th century, the demand for hand painted porcelain grew worldwide and the highly refined Nabeshima ware was produced. The Dutch East India Company shipped this Japanese Export Porcelain throughout the world. The work was so mass-produced; it lost much of the individualization of traditional folk pottery. However, the clean lines of this industrial ware provided the background for complex brushwork, making it once again, masterful work and outstanding in the competitive market.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-16" link_target="_self" maintainProportion="true" originalSource="" src="Nabeshima_plate_1688-1736.jpg" height="208" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="15" width="204" WOHratio="0.9837962962962963" y="2911" link="" x="103" uniqueID="element42" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.9837962962962963" imageRatio="0.9837962962962963" editMode="normalMode" origWidth="184" origHeight="188" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element43" deletable="" border-width="0" y="3097" x="105" width="149" editable="true" name="Text-27" height="20" padding="0" groupID="15" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Nabeshima 1688-1736</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-17" link_target="_self" maintainProportion="true" originalSource="" src="Nabashima_1628-1736.jpg" height="283" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="18" width="165" WOHratio="0.5810185185185185" y="2870" link="" x="417" uniqueID="element44" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.5810185185185185" imageRatio="0.5810185185185185" editMode="normalMode" origWidth="144" origHeight="248" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element45" deletable="" border-width="0" y="3119" x="456" width="114" editable="true" name="Text-28" height="20" padding="0" groupID="18" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Nabeshima 16thC</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-18" link_target="_self" maintainProportion="true" originalSource="" src="Nabeshima_bowl_18th_c_.jpg" height="196" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="17" width="269" WOHratio="1.3670886075949367" y="2908" link="" x="637" uniqueID="element46" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="1.3670886075949367" imageRatio="1.3670886075949367" editMode="normalMode" origWidth="244" origHeight="179" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element47" deletable="" border-width="0" y="3085" x="642" width="160" editable="true" name="Text-29" height="20" padding="0" groupID="17" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Nabeshima 18th C ad</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="3194" name="Text-30" x="88" templateID="" width="823" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="149" uniqueID="element48"><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold">By the 20th century, the word “mingei” surfaced, which means “folk art”, or art made by the unconscious collective. This phrase was termed by the Japanese art critic Soetsu Yanagi (1890-1961) and the potters Shoji Hamada (1894-1978) and Kanjiro Kawai (1890-1966). They inspired a movement that rejuvenated the return to traditional folk art in Japan. These three men also founded the Japan Folk Art Association and published the journal, Mingei, which since 1931, is still in print. Then, Yanagi, Hamada and the English potter, Bernard Leach toured Europe and the United States in the 1950’s, lecturing to eager Western potters the aesthetics of hand made pottery and the Japanese concepts of beauty.</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"></Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-19" link_target="_self" maintainProportion="true" originalSource="" src="Hamada_20th_c.jpg" height="330" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="39" width="230" WOHratio="0.6990740740740741" y="3380" link="" x="181" uniqueID="element49" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.6990740740740741" imageRatio="0.6990740740740741" editMode="normalMode" origWidth="231" origHeight="331" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element50" deletable="" border-width="0" y="3690" x="185" width="142" editable="true" name="Text-31" height="16" padding="0" groupID="39" bgcolor="" locked="" templateID=""><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica" font-style="bold">Hamada, Shoji 20th C </Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-20" link_target="_self" maintainProportion="true" originalSource="" src="Hamada_plate_20th_c.jpg" height="267" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="20" width="391" WOHratio="1.464406779661017" y="3358" link="" x="494" uniqueID="element51" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="1.464406779661017" imageRatio="1.464406779661017" editMode="normalMode" origWidth="329" origHeight="225" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element52" deletable="" border-width="0" y="3596" x="529" width="300" editable="true" name="Text-32" height="20" padding="0" groupID="20" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold" color="#FFFFFF">Hamada</Segment><Segment font-style="bold">, </Segment><Segment font-style="bold" color="#FFFFFF">Shoji  20th C </Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-21" link_target="_self" maintainProportion="true" originalSource="" src="Shimaoka__Tatsuzo_b._1919.jpg" height="245" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="21" width="243" WOHratio="0.9884259259259259" y="3758" link="" x="83" uniqueID="element53" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.9884259259259259" imageRatio="0.9884259259259259" editMode="normalMode" origWidth="243" origHeight="245" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element54" deletable="" border-width="0" y="3987" x="91" width="183" editable="true" name="Text-33" height="20" padding="0" groupID="21" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Shimaoka, Tatsuzo  b. 1919</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-22" link_target="_self" maintainProportion="true" originalSource="" src="Hamada_Bottle__20th_c.jpg" height="299" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="37" width="204" WOHratio="0.6828703703703703" y="3748" link="" x="424" uniqueID="element55" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.6828703703703703" imageRatio="0.6828703703703703" editMode="normalMode" origWidth="204" origHeight="299" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element56" deletable="" border-width="0" y="4031" x="434" width="155" editable="true" name="Text-34" height="16" padding="0" groupID="37" bgcolor="" locked="" templateID=""><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica" font-style="bold">Hamada, Shoji  20th C </Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-23" link_target="_self" maintainProportion="true" originalSource="" src="Tsujimura__Shiro_b._1948.jpg" height="282" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="23" width="232" WOHratio="0.8240740740740741" y="3686" link="" x="711" uniqueID="element57" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.8240740740740741" imageRatio="0.8240740740740741" editMode="normalMode" origWidth="232" origHeight="282" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element58" deletable="" border-width="0" y="3951" x="715" width="163" editable="true" name="Text-35" height="20" padding="0" groupID="23" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Tsujimura, Shiro, b. 1948</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="4106" name="Text-37" x="78" templateID="" width="823" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="111" uniqueID="element60"><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold">They spoke of the irregular and the asymmetrical, and how these attributes characterize the traditional Japanese concept of beauty. Japanese ceramics was not just an influence in style, but also an exploration in philosophy. It was an inquiry into the speculative rather than the observational, and it created the freedom to design. American potters were thirsty for this unconstrained approach to clay and welcomed the new aesthetic. </Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"></Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="4282" name="Text-38" x="82" templateID="" width="812" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="114" uniqueID="element61"><Paragraph><Segment color="#000000" font-size="12" font-family="Helvetica" font-style="bold">The latter part of the 20th century witnessed not only the return to handcrafted folk work but also the emergence of the "artist potter”. Individual Japanese studio potters produced elaborate one of a kind pieces, again proving the mastery of fine craftsmanship in the long tradition of Japanese ceramics. The beautiful vessels of Tommimoto and Tokuriki clearly reflect this mastery of detail, while the unconscious pottery of Hamada, Shimaoka and Tsujimura reveal the fabric of traditional folk pottery in a contemporary society. </Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-24" link_target="_self" maintainProportion="true" originalSource="" src="Tomimoto_jar_20th_c.jpg" height="219" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="" width="300" WOHratio="1.375796178343949" y="4466" link="" x="65" uniqueID="element62" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="1.375796178343949" imageRatio="1.375796178343949" editMode="normalMode" origWidth="300" origHeight="219" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element63" deletable="" border-width="0" y="4669" x="68" width="300" editable="true" name="Text-39" height="20" padding="0" groupID="" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Tomimoto                                               20th C</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-25" link_target="_self" maintainProportion="true" originalSource="" src="Tomimoto_20th_c.jpg" height="204" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="25" width="287" WOHratio="1.4025974025974026" y="4472" link="" x="394" uniqueID="element64" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="1.4025974025974026" imageRatio="1.4025974025974026" editMode="normalMode" origWidth="287" origHeight="204" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element65" deletable="" border-width="0" y="4660" x="398" width="300" editable="true" name="Text-40" height="20" padding="0" groupID="25" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold" color="#FFFFFF">Tomiomoto                                          20th C</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-26" link_target="_self" maintainProportion="true" originalSource="" src="Shirayamadani__Kataro__1865-1948.jpg" height="283" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="26" width="189" WOHratio="0.6689814814814815" y="4435" link="" x="734" uniqueID="element66" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.6689814814814815" imageRatio="0.6689814814814815" editMode="normalMode" origWidth="189" origHeight="283" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element67" deletable="" border-width="0" y="4704" x="734" width="145" editable="true" name="Text-41" height="20" padding="0" groupID="26" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">Shirayamadani, Katari </Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element68" deletable="" border-width="0" y="4683" x="887" width="57" editable="true" name="Text-42" height="32" padding="0" groupID="26" bgcolor="" locked="" templateID=""><Paragraph><Segment font-style="bold">1865-1958</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-27" link_target="_self" maintainProportion="true" originalSource="" src="new_logo.jpg" height="118" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="36" width="59" WOHratio="0.5" y="4733" link="index.html" x="184" uniqueID="element70" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.5" imageRatio="0.5" editMode="normalMode" origWidth="137" origHeight="274" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element69" deletable="" border-width="0" y="4777" x="185" width="167" editable="true" name="Text-43" height="30" padding="0" groupID="36" bgcolor="" locked="" templateID=""><Paragraph><Segment font-size="20" color="#28F9EA" font-style="bold" link_target="_self" href="index.html" font-family="Times New Roman">HOME PAGE</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element sizePositionLocked="false" border-color="#000000" type="Text" uniqueID="element72" deletable="" border-width="0" y="4765" x="608" width="148" editable="true" name="Text-45" height="54" padding="0" groupID="38" bgcolor="" locked="" templateID=""><Paragraph><Segment color="#F99976" font-size="12" font-family="Helvetica" font-style="bold" href="HISTORY.html" link_target="_self">Return to Moments in Ceramic History</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element isImageType="true" sizePositionLocked="false" name="Add an Image-28" link_target="_self" maintainProportion="true" originalSource="" src="Jomon_2000_bc.jpg" height="90" alt="" editable="true" resizeable="true" locked="" deletable="" groupID="38" width="72" WOHratio="0.8037037037037037" y="4742" link="HISTORY.html" x="520" uniqueID="element73" fileType="IMAGEFILTER" templateID="" type="ImportedImage" zoom="1" offsetY="0" offsetX="0" onPublish="ImportedImage" onPreview="ImportedImage" bucketRatio="0.8037037037037037" imageRatio="0.8037037037037037" editMode="normalMode" origWidth="217" origHeight="270" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element border-color="#000000" editable="true" border-width="0" y="140" name="Text-46" x="781" templateID="" width="153" locked="" bgcolor="" type="Text" padding="0" deletable="" sizePositionLocked="false" height="20" uniqueID="element76"><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"> © 2006 Jayne E. Shatz</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Form resizeable="no" height="auto" width="100%" y="" x=""/></Element><HeadTag><![CDATA[
    
