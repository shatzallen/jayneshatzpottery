editable="true" type="Text" border-width="0" padding="0" y="1946" bgcolor="" x="501" sizePositionLocked="false" width="546" locked="" deletable="" uniqueID="element35" groupID="3"><Paragraph align="center"><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">White On White Tile Panel, white glazed, iron stained and gold lustered pieces, awards from the Director of the Museum of Contemporary Crafts, NYC, 1959</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-17" templateID="" height="54" editable="true" type="Text" border-width="0" padding="0" y="2845" bgcolor="" x="519" sizePositionLocked="false" width="446" locked="" deletable="" uniqueID="element36" groupID="4"><Paragraph align="center"><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">President’s Piece, SUNY Albany, multi slab construction,</Segment></Paragraph><Paragraph align="center"><Segment color="#FFFFFF" font-size="12" font-family="Helvetica"> raw clay with iron oxide, cone 10 reduction, 1971</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-18" templateID="" height="72" editable="true" type="Text" border-width="0" padding="0" y="3554" bgcolor="" x="334" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element37" groupID="6"><Paragraph align="center"><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">Box with Soft Cover, 46 in high, hard edge slab with slab molded "soft" cover, white and black iron glaze, cone 6, reduction, 1971</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-19" templateID="" height="72" editable="true" type="Text" border-width="0" padding="0" y="3546" bgcolor="" x="798" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element38" groupID="7"><Paragraph align="center"><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">Hard Box, Soft Cover, 42 in high, hard edge  slab with molded "soft" cover, </Segment></Paragraph><Paragraph align="center"><Segment color="#FFFFFF" font-size="12" font-family="Helvetica"> white and ochre matt glaze, cone 6, reduction, 1966</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-20" templateID="" height="72" editable="true" type="Text" border-width="0" padding="0" y="4111" bgcolor="" x="574" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element39" groupID="8"><Paragraph align="center"><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">Covered Box Smoked, using fiberglass and deflocculated casting slip. Smoke effect with nickel oxide and Albany slip, 1971</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-21" templateID="" height="72" editable="true" type="Text" border-width="0" padding="0" y="4744" bgcolor="" x="127" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element40" groupID="12"><Paragraph align="center"><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">Porcelain forms, fiber glass and slipped with cobalt and iron oxides wedged in, molded over a fine foam rubber form, 1973</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-22" templateID="" height="72" editable="true" type="Text" border-width="0" padding="0" y="4735" bgcolor="" x="612" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element41" groupID="10"><Paragraph align="center"><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">Electroplated forms, copper electroformed on porcelain horn and bone shapes, copper red and clear glaze, cone 10 reduction, 1973</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-23" templateID="" height="36" editable="true" type="Text" border-width="0" padding="0" y="4737" bgcolor="" x="1051" sizePositionLocked="false" width="332" locked="" deletable="" uniqueID="element42" groupID="9"><Paragraph><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">Egyptian Foot, porcelain covered form, 1973</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Element name="Image-14" templateID="" alt="" height="506" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="5197" x="674" src="FRAN-14.jpg" sizePositionLocked="false" resizeable="true" link="" width="239" locked="" deletable="" WOHratio="0.4717607973421927" fileType="IMAGEFILTER" uniqueID="element44" originalSource="" bucketRatio="0.4717607973421927" imageRatio="0.4717607973421927" offsetX="0" offsetY="0" zoom="1" editMode="normalMode" origWidth="284" origHeight="602" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-24" templateID="" height="108" editable="true" type="Text" border-width="0" padding="0" y="5436" bgcolor="" x="271" sizePositionLocked="false" width="300" locked="" deletable="" uniqueID="element45"><Paragraph><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">All photographs by Jayne Shatz, </Segment></Paragraph><Paragraph><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">except photo of Fran for the Memorial Exhibitions  Invitation. The portrait of </Segment></Paragraph><Paragraph><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">Fran was a photo given to Jayne by </Segment></Paragraph><Paragraph><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">Ray Simches, Fran’s husband. </Segment></Paragraph><Paragraph><Segment color="#FFFFFF" font-size="12" font-family="Helvetica">The photographer is unidentified.</Segment></Paragraph></Element><?property ignore-whitespace="true"?><Form resizeable="no" height="auto" width="100%" y="" x=""/></Element><HeadTag><![CDATA[
    
