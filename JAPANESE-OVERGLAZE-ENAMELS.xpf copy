"" height="384" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="9288" x="389" src="S1993_26.png" sizePositionLocked="false" resizeable="true" link="" width="278" locked="" deletable="" WOHratio="0.7248062015503876" fileType="IMAGEFILTER" uniqueID="element50" originalSource="" bucketRatio="0.7248062015503876" imageRatio="0.7248062015503876" offsetX="0" offsetY="0" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="187" origHeight="258" imageWidth="187" imageHeight="258" groupID="42"/><Element name="Image-16" templateID="" alt="" height="309" editable="true" maintainProportion="true" link_target="_self" type="ImportedImage" isImageType="true" y="10491" x="261" src="S1993_37.png" sizePositionLocked="false" resizeable="true" link="" width="491" locked="" deletable="" WOHratio="1.588235294117647" fileType="IMAGEFILTER" uniqueID="element51" originalSource="" bucketRatio="1.588235294117647" imageRatio="1.5815899581589958" offsetX="0" offsetY="-0.0020920502092050207" zoom="1" rotate="0" brightness="0" contrast="0" colorEffect="" tintRed="0" tintGreen="0" tintBlue="0" borderWidth="0" borderColor="#52A8EC" borderRadius="0" boxShadow="none" glowColor="#52A8EC" origWidth="378" origHeight="239" imageWidth="378" imageHeight="239" groupID="44"/><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-27" templateID="" height="84" editable="true" type="Text" border-width="0" padding="0" y="8016" bgcolor="" x="102" sizePositionLocked="false" width="882" locked="" deletable="" uniqueID="element52"><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">Bowl, Shindo Susumu , 1992. (Japanese, b. 1952).  The bowl is porcelain with black pigment under blue enamel. The bowl is painted in a rhythmic geometric pattern H 9.8, W 55.2, D 55.2. Komatsu City, Japan. The wide open form sits on an extremely small foot.</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="10" font-family="Helvetica"></Segment><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">Arthur M. Sackler Gallery, Gift of the Japan Foundation S1993.21</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-28" templateID="" height="63" editable="true" type="Text" border-width="0" padding="0" y="8512" bgcolor="" x="137" sizePositionLocked="false" width="896" locked="" deletable="" uniqueID="element53" groupID="40"><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">Miura Shurei , Bowl, 1992, (Japanese, b. 1942),  Stoneware with "peacock feather" iron glaze</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">H: 19.3 W: 42.5 D: 42.5 cm, Fujiyoshida City, Japan</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">Arthur M. Sackler Gallery, Gift of the Japan Foundation S1993.35 </Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-29" templateID="" height="84" editable="true" type="Text" border-width="0" padding="0" y="9083" bgcolor="" x="117" sizePositionLocked="false" width="898" locked="" deletable="" uniqueID="element54" groupID="41"><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">Vase.1992,  Taka Akira , (Japanese, born 1936). Porcelain vase has a design of a grove of trees</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">with silver leaf under blue glaze, platinum and gold enamels over the glaze</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">H: 39.7 W: 28.3 D: 28.3 cm, Komatsu City, Japan</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">Arthur M. Sackler Gallery, Gift of the Japan Foundation S1993.23</Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-30" templateID="" height="84" editable="true" type="Text" border-width="0" padding="0" y="9692" bgcolor="" x="157" sizePositionLocked="false" width="904" locked="" deletable="" uniqueID="element55" groupID="42"><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">Vase, 1990, Tamura Keisei , (Japanese, born 1949)</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">The Porcelain vase is painted in polychrome and silver enamels over colorless glaze</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">H: 53.3 W: 19.2 D: 19.2 cm, Komatsu City, Japan</Segment></Paragraph><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">Arthur M. SacklerGallery,  Gift of the Japan Foundation S1993.26 </Segment></Paragraph></Element><?property ignore-whitespace="true"?><?property ignore-whitespace="false"?><Element border-color="#000000" name="Text-31" templateID="" height="129" editable="true" type="Text" border-width="0" padding="0" y="10250" bgcolor="" x="108" sizePositionLocked="false" width="911" locked="" deletable="" uniqueID="element56" groupID="43"><Paragraph><Segment color="#000000" font-size="14" font-family="Helvetica" font-style="bold">Bowl, 1990,  Nakashima Ken'ichi , (Japanese, b. 1949). This piece has a design of tradescantia flowers. The bowl fully expresses the tradition of Kutani overglaze enamel decoration.  Aft